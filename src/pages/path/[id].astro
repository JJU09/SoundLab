---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { HUB_META } from '../../content.config';
import { PATHS } from '../../lib/paths';

export async function getStaticPaths() {
  return PATHS.map(p => ({ params: { id: p.id }, props: { path: p } }));
}
const { path } = Astro.props;
const base = import.meta.env.BASE_URL;
const all = (await getCollection('topics')).filter(t => !t.data.draft);
const info = (id: string) => {
  const t = all.find(x => x.id === id);
  if (!t) throw new Error(`경로 ${path.id}: 레슨 ${id} 없음`);
  return { id, href: `${base}learn/${id}/`, title: t.data.title, kr: t.data.kr, tagline: t.data.tagline, hub: HUB_META[t.data.hub].kr };
};
const stages = path.stages.map(s => ({ ...s, L: s.lessons.map(info), D: (s.deeper ?? []).map(info) }));
const core = stages.flatMap(s => s.L);
const first = core.find((_, i) => !stages[0].optional || i >= stages[0].L.length) ?? core[0];
---
<Base title={`${path.kr} — 로드맵`} description={path.desc}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <nav class="flex items-center gap-2 text-xs font-mono text-[var(--color-ink-300)] mb-8">
      <a href={base} class="hover:text-[var(--color-violet)] transition">홈</a><span>/</span>
      <a href={`${base}path/`} class="hover:text-[var(--color-violet)] transition">로드맵</a><span>/</span>
      <span class="text-[var(--color-ink-700)]">{path.kr}</span>
    </nav>

    <span class="text-xs font-mono px-2.5 py-1 rounded-full border border-[var(--color-violet-light)] text-[var(--color-violet)] bg-[var(--color-violet-glow)]">ROADMAP · {path.genre}</span>
    <h1 class="text-3xl sm:text-4xl font-bold mt-4 mb-3 leading-tight font-display">
      {path.kr} <span class="hidden sm:inline text-[var(--color-ink-300)] font-medium text-2xl ml-1">{path.title}</span>
    </h1>
    <p class="text-[var(--color-ink-700)] leading-relaxed mb-6">{path.desc}</p>

    <!-- 요약 + 진행 -->
    <div class="p-5 rounded-2xl border border-[var(--color-border)] bg-white mb-10">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 justify-between">
        <div class="min-w-0">
          <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-ink-300)]">완성하면</div>
          <div class="font-semibold text-[var(--color-ink-700)]">{path.result}</div>
          <div class="text-xs text-[var(--color-ink-500)] mt-1">{stages.some(s => s.optional) ? `준비 + ${stages.filter(s => !s.optional).length}단계` : `${stages.length}단계`} · 핵심 레슨 {core.length}개</div>
        </div>
        <a id="path-cta" href={first.href} data-core={JSON.stringify(core.map(l => l.id))} data-hrefs={JSON.stringify(core.map(l => l.href))}
          class="shrink-0 whitespace-nowrap gradient-brand text-white font-semibold px-5 py-2.5 rounded-xl text-sm text-center transition hover:opacity-90 font-display">첫 레슨 시작하기 →</a>
      </div>
      <div class="mt-4">
        <div class="h-2 rounded-full bg-[var(--color-surface-2)] overflow-hidden"><div id="path-bar" class="h-full gradient-brand" style="width:0%"></div></div>
        <div id="path-count" class="text-[11px] font-mono text-[var(--color-ink-300)] mt-1.5">읽은 레슨 0 / {core.length} · 이 브라우저에만 저장돼요</div>
      </div>
    </div>

    <!-- 단계 타임라인 -->
    <ol class="relative space-y-6">
      {stages.map((s, i) => (
        <li class="relative pl-12 sm:pl-14">
          {i < stages.length - 1 && <span class="absolute left-[19px] sm:left-[23px] top-11 bottom-[-1.5rem] w-px bg-[var(--color-border)]"></span>}
          <span class="path-dot absolute left-0 top-0 w-10 h-10 sm:w-12 sm:h-12 rounded-xl gradient-brand text-white flex items-center justify-center font-mono font-bold text-sm" data-stage={JSON.stringify(s.lessons)}>{i}</span>
          <div class="p-5 rounded-2xl border border-[var(--color-border)] bg-white">
            <div class="flex items-baseline gap-2 flex-wrap mb-1">
              <h2 class="text-xl font-bold font-display">{s.title}</h2>
              {s.optional && <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[var(--color-surface-2)] text-[var(--color-ink-500)]">선택 · 건반을 안다면 건너뛰기</span>}
            </div>
            <p class="text-sm text-[var(--color-ink-500)] mb-4">{s.goal}</p>

            <div class="space-y-2 mb-4">
              {s.L.map((l, j) => (
                <a href={l.href} data-lesson={l.id} class="path-lesson group flex items-center gap-3 p-3 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-violet)] transition">
                  <span class="path-check w-6 h-6 flex-none rounded-full border border-[var(--color-border)] flex items-center justify-center text-[10px] font-mono text-[var(--color-ink-300)]">{j + 1}</span>
                  <div class="min-w-0 flex-1">
                    <div class="text-sm font-semibold text-[var(--color-ink-700)] group-hover:text-[var(--color-violet)] transition">{l.kr} <span class="font-normal text-[var(--color-ink-300)]">{l.title}</span></div>
                    <div class="text-xs text-[var(--color-ink-500)] truncate">{l.tagline}</div>
                  </div>
                  <span class="hidden sm:inline text-[10px] font-mono text-[var(--color-ink-300)] shrink-0">{l.hub}</span>
                </a>
              ))}
            </div>

            <div class="rounded-xl bg-[var(--color-surface)] p-4">
              <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-violet)] mb-1">이 단계의 결과물</div>
              <div class="text-sm font-semibold text-[var(--color-ink-700)] mb-2">{s.output}</div>
              <ul class="space-y-1">
                {s.checklist.map(c => <li class="flex gap-2 text-xs text-[var(--color-ink-500)]"><span class="text-[var(--color-violet)]">☐</span>{c}</li>)}
              </ul>
            </div>

            {s.sketch && (
              <a href={`${base}sandbox/sketch/?tab=${s.sketch.tab}`} class="mt-4 flex items-center justify-between gap-3 p-3 rounded-xl border border-[var(--color-violet-light)] bg-[var(--color-violet-glow)] hover:border-[var(--color-violet)] transition group">
                <span class="text-sm font-semibold text-[var(--color-violet)] font-display">🎼 {s.sketch.label}</span>
                <span class="text-xs text-[var(--color-ink-500)] group-hover:text-[var(--color-violet)] whitespace-nowrap">곡 스케치 →</span>
              </a>
            )}

            {s.D.length > 0 && (
              <div class="flex flex-wrap items-center gap-2 mt-4 text-sm">
                <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink-300)]">더 깊이</span>
                {s.D.map(d => <a href={d.href} class="px-2.5 py-1 rounded-full border border-[var(--color-border)] text-[var(--color-ink-700)] hover:border-[var(--color-violet)] hover:text-[var(--color-violet)] transition text-xs">{d.kr}</a>)}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>

    <p class="text-sm text-[var(--color-ink-500)] mt-10 text-center">
      주제별로 찾아보고 싶다면 <a href={`${base}learn/`} class="text-[var(--color-violet)] hover:underline">레슨</a>에서 전체 {all.length}개 레슨을 둘러보세요.
    </p>
  </div>

  <script>
    let seen: string[] = [];
    try { seen = JSON.parse(localStorage.getItem('sl-visited') || '[]'); } catch {}
    const has = new Set(seen);
    document.querySelectorAll<HTMLElement>('.path-lesson').forEach(a => {
      if (!has.has(a.dataset.lesson!)) return;
      a.classList.add('is-done');
      const c = a.querySelector('.path-check')!;
      c.textContent = '✓';
      c.classList.add('gradient-brand', 'text-white', '!border-transparent');
    });
    const cta = document.getElementById('path-cta') as HTMLAnchorElement | null;
    if (cta) {
      const core: string[] = JSON.parse(cta.dataset.core!);
      const hrefs: string[] = JSON.parse(cta.dataset.hrefs!);
      const done = core.filter(id => has.has(id)).length;
      document.getElementById('path-bar')!.style.width = `${Math.round(done / core.length * 100)}%`;
      document.getElementById('path-count')!.textContent = `읽은 레슨 ${done} / ${core.length} · 이 브라우저에만 저장돼요`;
      if (done > 0) {
        const i = core.findIndex(id => !has.has(id));
        if (i < 0) cta.textContent = '처음부터 다시 보기 →', cta.href = hrefs[0];
        else cta.textContent = '이어서 하기 →', cta.href = hrefs[i];
      }
    }
  </script>
</Base>
