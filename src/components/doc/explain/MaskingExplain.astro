---
// 파일럿 ③ 현상 비교형 — 주파수 마스킹: 목소리 높이·크기 장면 2개 / EQ 전·후 스펙트럼 2개 (①~⑤ 단계)
import Explain from './Explain.astro';
import { INK, META, TECH } from './tokens';
interface Props { simple?: boolean; }
const { simple = false } = Astro.props;
const uid = 'msk' + Math.random().toString(36).slice(2, 7);

// ── 원리 그래프 계산 (개념 곡선 — 실제 측정값 아님)
const BASS = '#2563eb', MEL = '#d97706';                 // 위젯과 같은 역할 색: 베이스 파랑, 멜로디 노랑 계열
const F0 = 50, F1 = 5000, OX = 40, GW = 268, GT = 62, GH = 146;
const lg = (f: number) => Math.log2(f);
const g = (d: number, s: number) => Math.exp(-(d * d) / (2 * s * s));
const bass = (f: number) => Math.max(0.95 * g(lg(f / 100), 0.75), 0.56 * g(lg(f / 420), 0.75)); // 기음(100 Hz) + 배음 대역
const notch = (f: number) => 1 - 0.65 * g(lg(f / 550), 0.5);                  // EQ: 베이스를 550 Hz 근처에서 깎음
const mel = (f: number) => 0.34 * g(lg(f / 550), 0.42);                          // 멜로디(작은 소리)
const spread = (d: number) => g(d, d < 0 ? 0.3 : 0.75);                           // 마스킹 확산: 높은 쪽으로 더 넓게
const SRC = Array.from({ length: 121 }, (_, i) => F0 * Math.pow(F1 / F0, i / 120));
const maskOf = (b: (f: number) => number) => (f: number) => Math.max(0, Math.max(...SRC.map(fs => b(fs) * spread(lg(f) - lg(fs)))) - 0.06);
const freqs = Array.from({ length: 91 }, (_, i) => F0 * Math.pow(F1 / F0, i / 90));
const X = (f: number) => OX + (lg(f) - lg(F0)) / (lg(F1) - lg(F0)) * GW;
const Y = (v: number) => GT + GH - v * GH;
const pts = (fn: (f: number) => number) => freqs.map(f => `${X(f).toFixed(1)},${Y(fn(f)).toFixed(1)}`).join(' ');
const area = (fn: (f: number) => number) => `${X(F0)},${Y(0)} ${pts(fn)} ${X(F1)},${Y(0)}`;
const bEq = (f: number) => bass(f) * notch(f);
const m0 = maskOf(bass), m1 = maskOf(bEq);
const G = {
  bassA: area(bass), bassL: pts(bass), maskA: pts(m0), melA: area(mel), melL: pts(mel),
  bassB: area(bEq), bassBL: pts(bEq), maskB: pts(m1),
  cut: `${pts(bass)} ${freqs.slice().reverse().map(f => `${X(f).toFixed(1)},${Y(bEq(f)).toFixed(1)}`).join(' ')}`,
};
const ticks = [50, 100, 200, 500, 1000, 2000, 5000].map(f => ({ x: X(f), t: f >= 1000 ? `${f / 1000}k` : String(f) }));
const P = { mx: X(550), melY: Y(mel(550)), bassY: Y(bass(550)), mask0Y: Y(m0(550)), mask1Y: Y(m1(550)), eqY: Y(bEq(550)) };
---
<Explain simple={simple} layout="stack" title="주파수 마스킹" question="분명 재생되는데 왜 멜로디가 안 들릴까?"
  label="주파수 마스킹 설명 그림: 같은 높이로 말하면 큰 목소리가 작은 목소리를 덮고, 높이를 비키면 둘 다 들린다. 베이스와 멜로디의 대역이 겹치고 베이스가 더 크면 멜로디가 가려지는 경계 아래로 묻힌다. EQ로 베이스의 550 Hz 근처를 깎으면 경계가 내려가 멜로디가 들린다."
  map={[['목소리 높이', '주파수 대역'], ['목소리 크기', '레벨'], ['큰 목소리에 묻힘', '마스킹'], ['높이 비키기', 'EQ로 대역 나누기']]}
  message="대역이 겹치고 레벨 차가 크면 작은 소리가 묻힌다. EQ로 자리를 나누면 둘 다 들린다."
  caption="그래프는 개념을 보여 주는 단순화입니다. 겹쳐도 레벨 차가 작거나 대역이 충분히 떨어져 있으면 묻히지 않고, 마스킹은 가리는 소리보다 높은 주파수 쪽으로 더 넓게 퍼집니다.">
  <div slot="metaphor" class="ex-duo">
    <svg viewBox="0 0 320 226" role="img" aria-label="같은 높이로 말하면 큰 목소리의 말풍선이 작은 목소리를 덮는다">
      <defs><marker id={`${uid}m`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L10 5L0 10z" fill={META.outline} /></marker></defs>
      <text x="160" y="16" text-anchor="middle" font-size="12" font-weight="700" fill={META.outline}>같은 높이로 말할 때</text>
      <path d="M20 190 V40" stroke={META.outline} stroke-width="1.5" marker-end={`url(#${uid}m)`} />
      <text x="13" y="116" text-anchor="middle" font-size="10.5" fill={META.outline} transform="rotate(-90 13 116)">목소리 높이</text>
      <line x1="30" x2="310" y1="196" y2="196" stroke={META.outline} stroke-width="2" stroke-linecap="round" />
      <rect x="52" y="110" width="40" height="86" rx="20" fill={META.coral} stroke={META.outline} stroke-width="2" />
      <circle cx="66" cy="128" r="2" fill={META.outline} /><circle cx="78" cy="128" r="2" fill={META.outline} />
      <ellipse cx="72" cy="144" rx="7" ry="5" fill={META.outline} />
      <rect x="248" y="144" width="26" height="52" rx="13" fill={META.sky} stroke={META.outline} stroke-width="2" />
      <circle cx="257" cy="158" r="1.8" fill={META.outline} /><circle cx="265" cy="158" r="1.8" fill={META.outline} />
      <ellipse cx="236" cy="96" rx="36" ry="17" fill={META.cream} stroke={META.outline} stroke-width="1.5" opacity="0.8" />
      <text x="250" y="100" text-anchor="middle" font-size="11" fill={META.outline} opacity="0.45">안녕?</text>
      <ellipse cx="150" cy="96" rx="66" ry="32" fill={META.cream} stroke={META.outline} stroke-width="2" />
      <path d="M96 110 L88 124 L110 114" fill={META.cream} stroke={META.outline} stroke-width="2" stroke-linejoin="round" />
      <text x="150" y="102" text-anchor="middle" font-size="16" font-weight="700" fill={META.outline}>웅웅웅!!</text>
      <text x="160" y="218" text-anchor="middle" font-size="11" font-weight="600" fill={META.outline}>큰 목소리 → 작은 목소리가 묻힘</text>
    </svg>
    <svg viewBox="0 0 320 226" role="img" aria-label="작은 사람이 다른 높이로 말하면 두 말풍선이 겹치지 않아 둘 다 들린다">
      <text x="160" y="16" text-anchor="middle" font-size="12" font-weight="700" fill={META.outline}>높이를 비켜 말할 때</text>
      <path d="M20 190 V40" stroke={META.outline} stroke-width="1.5" marker-end={`url(#${uid}m)`} />
      <text x="13" y="116" text-anchor="middle" font-size="10.5" fill={META.outline} transform="rotate(-90 13 116)">목소리 높이</text>
      <line x1="30" x2="310" y1="196" y2="196" stroke={META.outline} stroke-width="2" stroke-linecap="round" />
      <rect x="52" y="110" width="40" height="86" rx="20" fill={META.coral} stroke={META.outline} stroke-width="2" />
      <circle cx="66" cy="128" r="2" fill={META.outline} /><circle cx="78" cy="128" r="2" fill={META.outline} />
      <ellipse cx="72" cy="144" rx="7" ry="5" fill={META.outline} />
      <ellipse cx="150" cy="134" rx="62" ry="28" fill={META.cream} stroke={META.outline} stroke-width="2" />
      <path d="M98 146 L90 158 L112 150" fill={META.cream} stroke={META.outline} stroke-width="2" stroke-linejoin="round" />
      <text x="150" y="140" text-anchor="middle" font-size="16" font-weight="700" fill={META.outline}>웅웅웅!!</text>
      <rect x="248" y="144" width="26" height="52" rx="13" fill={META.sky} stroke={META.outline} stroke-width="2" />
      <circle cx="257" cy="158" r="1.8" fill={META.outline} /><circle cx="265" cy="158" r="1.8" fill={META.outline} />
      <path d="M257 174 q 4 4 8 0" fill="none" stroke={META.outline} stroke-width="1.5" />
      <ellipse cx="250" cy="56" rx="38" ry="18" fill={META.cream} stroke={META.outline} stroke-width="2" />
      <path d="M248 72 L252 86 L260 73" fill={META.cream} stroke={META.outline} stroke-width="2" stroke-linejoin="round" />
      <text x="250" y="61" text-anchor="middle" font-size="13" font-weight="700" fill={META.outline}>안녕?</text>
      <text x="160" y="218" text-anchor="middle" font-size="11" font-weight="600" fill={META.outline}>다른 높이 → 둘 다 들림</text>
    </svg>
  </div>
  <div slot="principle" class="ex-duo">
    <svg viewBox="0 0 320 250" role="img" aria-label="EQ 전: 베이스와 멜로디 대역이 겹치고 베이스가 더 커서, 멜로디가 가려지는 경계 아래에 묻힌다">
      <defs><marker id={`${uid}k`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill={INK.ink} /></marker></defs>
      <text x="8" y="18" font-size="13" font-weight="700" fill={INK.ink}>EQ 전</text>
      <rect x={X(300)} y={GT - 26} width={X(900) - X(300)} height="5" rx="2.5" fill={TECH.change} opacity="0.7" />
      <text x={X(900) + 6} y={GT - 20} font-size="11" font-weight="700" fill={TECH.change}>① 대역이 겹침</text>
      <line x1={OX} x2={OX + GW} y1={Y(0)} y2={Y(0)} stroke={TECH.axis} />
      <line x1={OX} x2={OX} y1={GT - 4} y2={Y(0)} stroke={TECH.axis} />
      {ticks.map(t => <text x={t.x} y={Y(0) + 13} text-anchor="middle" font-size="10" class="num" fill={INK.sub}>{t.t}</text>)}
      <text x={OX + GW} y={Y(0) + 27} text-anchor="end" font-size="10.5" fill={INK.sub}>주파수 (Hz) →</text>
      <text x={OX - 4} y={GT + 2} text-anchor="end" font-size="10.5" fill={INK.sub}>크기</text>
      <polygon points={G.bassA} fill={BASS} opacity="0.15" />
      <polyline points={G.bassL} fill="none" stroke={BASS} stroke-width="2" />
      <polyline points={G.maskA} fill="none" stroke={TECH.limit} stroke-width="1.6" stroke-dasharray="5 4" />
      <polygon points={G.melA} fill={MEL} opacity="0.14" />
      <polyline points={G.melL} fill="none" stroke={MEL} stroke-width="2" stroke-dasharray="3 3" />
      <text x={X(108)} y={GT + 2} font-size="11" font-weight="600" fill={BASS}>베이스 (큰 소리)</text>
      <text x="306" y={Y(0) - 34} text-anchor="end" font-size="11" font-weight="600" fill={TECH.limit}>가려지는 경계</text>
      <line x1={X(2600)} y1={Y(0) - 30} x2={X(1600)} y2={Y(m0(1600)) - 2} stroke={TECH.limit} />
      <line x1={P.mx + 8} x2={P.mx + 8} y1={P.melY - 2} y2={P.mask0Y + 2} stroke={INK.ink} stroke-width="1.4" marker-start={`url(#${uid}k)`} marker-end={`url(#${uid}k)`} />
      <text x={P.mx + 16} y={P.mask0Y - 22} font-size="11" font-weight="700" fill={INK.ink}>② 레벨 차가 큼</text>
      <text x={P.mx + 16} y={P.mask0Y - 9} font-size="10.5" fill={INK.sub}>멜로디가 경계 아래</text>
      <text x={X(2600)} y={Y(0) - 10} text-anchor="middle" font-size="11" font-weight="700" fill={MEL}>③ 멜로디 묻힘</text>
      <line x1={X(800)} y1={Y(mel(800)) + 2} x2={X(2000)} y2={Y(0) - 22} stroke={MEL} />
    </svg>
    <svg viewBox="0 0 320 250" role="img" aria-label="EQ 후: 베이스의 550 Hz 근처를 깎자 가려지는 경계도 내려가 멜로디가 경계 위로 올라와 들린다">
      <defs><marker id={`${uid}j`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L10 5L0 10z" fill={TECH.change} /></marker></defs>
      <text x="8" y="18" font-size="13" font-weight="700" fill={INK.ink}>EQ 후</text>
      <text x="8" y="36" font-size="11" font-weight="700" fill={TECH.change}>④ 베이스의 550 Hz 근처를 EQ로 깎음</text>
      <line x1={OX} x2={OX + GW} y1={Y(0)} y2={Y(0)} stroke={TECH.axis} />
      <line x1={OX} x2={OX} y1={GT - 4} y2={Y(0)} stroke={TECH.axis} />
      {ticks.map(t => <text x={t.x} y={Y(0) + 13} text-anchor="middle" font-size="10" class="num" fill={INK.sub}>{t.t}</text>)}
      <text x={OX + GW} y={Y(0) + 27} text-anchor="end" font-size="10.5" fill={INK.sub}>주파수 (Hz) →</text>
      <text x={OX - 4} y={GT + 2} text-anchor="end" font-size="10.5" fill={INK.sub}>크기</text>
      <polygon points={G.bassB} fill={BASS} opacity="0.15" />
      <polygon points={G.cut} fill={TECH.change} opacity="0.22" />
      <polyline points={G.bassL} fill="none" stroke={BASS} stroke-width="1" stroke-dasharray="2 3" opacity="0.6" />
      <polyline points={G.bassBL} fill="none" stroke={BASS} stroke-width="2" />
      <polyline points={G.maskA} fill="none" stroke={TECH.limit} stroke-width="1" stroke-dasharray="2 4" opacity="0.45" />
      <polyline points={G.maskB} fill="none" stroke={TECH.limit} stroke-width="1.6" stroke-dasharray="5 4" />
      <line x1={P.mx - 22} x2={P.mx - 22} y1={P.bassY + 2} y2={P.eqY - 8} stroke={TECH.change} stroke-width="1.8" marker-end={`url(#${uid}j)`} />
      <polygon points={G.melA} fill={MEL} opacity="0.3" />
      <polyline points={G.melL} fill="none" stroke={MEL} stroke-width="2.5" />
      <text x="306" y={P.melY - 34} text-anchor="end" font-size="11" font-weight="700" fill={MEL}>⑤ 경계 위로 → 들림</text>
      <line x1={P.mx + 8} y1={P.melY - 2} x2="250" y2={P.melY - 30} stroke={MEL} />
      <text x={X(108)} y={GT + 2} font-size="11" font-weight="600" fill={BASS}>베이스</text>
      <text x="306" y={Y(0) - 30} text-anchor="end" font-size="10.5" fill={TECH.limit}>경계도 함께 내려감</text>
    </svg>
  </div>
</Explain>
