---
// 숫자 축 위의 범위 (BPM 범위 등) — 선 도면형. to가 없으면 점.
import Fig from './Fig.astro'; import { C } from './colors';
interface Item { label: string; from: number; to?: number; note?: string; }
interface Props { items: Item[]; min: number; max: number; step: number; unit?: string; caption?: string; label: string; }
const { items, min, max, step, unit = '', caption, label } = Astro.props as Props;
const L = 116, R = 548, W = 560, RH = 30, top = 8, bottom = top + items.length * RH + 4, H = bottom + 22;
const x = (v: number) => L + (v - min) / (max - min) * (R - L);
const ticks = Array.from({ length: Math.floor((max - min) / step) + 1 }, (_, i) => ({ v: min + i * step, x: x(min + i * step) }));
const rows = items.map((it, i) => {
  const to = it.to ?? it.from, isRange = to - it.from > 0, flip = x(to) - (R - 96) > 0;
  return { label: it.label, y: top + i * RH + RH / 2, isRange, x0: x(it.from), x1: x(to),
    tx: flip ? x(it.from) - 12 : x(to) + 12, anchor: flip ? 'end' : 'start',
    txt: (it.note ?? (isRange ? `${it.from}–${to}` : `약 ${it.from}`)) + unit };
});
---
<Fig caption={caption} minW={440} label={label}>
  <svg viewBox={`0 0 ${W} ${H}`}>
    {ticks.map(t => <line x1={t.x} x2={t.x} y1={top} y2={bottom + 4} stroke={C.line} />)}
    <line x1={L} x2={R} y1={bottom} y2={bottom} stroke={C.ink3} />
    {ticks.map(t => <text x={t.x} y={bottom + 18} font-size="10" fill={C.ink5} text-anchor="middle" class="mono">{t.v}</text>)}
    {rows.map(r => <text x="2" y={r.y + 4} font-size="12" font-weight="600" fill={C.ink}>{r.label}</text>)}
    {rows.filter(r => r.isRange).map(r => <line x1={r.x0} x2={r.x1} y1={r.y} y2={r.y} stroke={C.violet} stroke-width="8" stroke-linecap="round" />)}
    {rows.filter(r => !r.isRange).map(r => <circle cx={r.x0} cy={r.y} r="5.5" fill={C.violet} />)}
    {rows.map(r => <text x={r.tx} y={r.y + 3.5} font-size="10.5" fill={C.ink5} text-anchor={r.anchor}>{r.txt}</text>)}
  </svg>
</Fig>
