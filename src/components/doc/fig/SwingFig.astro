---
// 스트레이트 vs 스윙 — 선 도면형. 한 박 안에서 뒤 8분음표가 오는 위치
import Fig from './Fig.astro'; import { C } from './colors';
interface Props { rows?: { pct: number; label: string }[]; caption?: string; }
const { rows = [{ pct: 50, label: '스트레이트 1 : 1' }, { pct: 60, label: '가벼운 스윙' }, { pct: 67, label: '셔플 2 : 1' }], caption } = Astro.props as Props;
const L = 132, BW = 200, W = L + 2 * BW + 12, RH = 40, top = 26, bottom = top + rows.length * RH, H = bottom + 20;
const beats = [0, 1].map(b => ({ x: L + b * BW, half: L + b * BW + BW / 2, t2: L + b * BW + BW * 2 / 3, n: b + 1 }));
const lanes = rows.map((r, i) => ({ ...r, y: top + i * RH + RH / 2, f: r.pct / 100 }));
const segs = lanes.flatMap(r => beats.map(b => ({ y: r.y, x0: b.x, f: r.f })));
---
<Fig caption={caption} minW={440} label="스트레이트와 스윙에서 뒤 8분음표의 위치 비교">
  <svg viewBox={`0 0 ${W} ${H}`}>
    {[0, 1, 2].map(b => <line x1={L + b * BW} x2={L + b * BW} y1={top - 4} y2={bottom + 4} stroke={C.ink3} />)}
    {beats.map(b => <line x1={b.half} x2={b.half} y1={top - 4} y2={bottom + 4} stroke={C.line} />)}
    {beats.map(b => <line x1={b.t2} x2={b.t2} y1={top - 4} y2={bottom + 4} stroke={C.blueL} />)}
    {beats.map(b => <text x={b.x} y={top - 12} font-size="10" fill={C.ink5} text-anchor="middle" class="mono">{b.n}박</text>)}
    {beats.map(b => <text x={b.half} y={bottom + 16} font-size="10" fill={C.ink5} text-anchor="middle">반 박</text>)}
    {beats.map(b => <text x={b.t2 + 4} y={bottom + 16} font-size="10" fill={C.blue}>셋잇단 셋째</text>)}
    {lanes.map(r => <text x="2" y={r.y - 1} font-size="13" class="fd" fill={C.ink}>{r.pct}%</text>)}
    {lanes.map(r => <text x="2" y={r.y + 13} font-size="10.5" fill={C.ink5}>{r.label}</text>)}
    {lanes.map(r => <line x1={L} x2={L + 2 * BW} y1={r.y} y2={r.y} stroke={C.ink3} />)}
    {segs.map(s => <circle cx={s.x0} cy={s.y} r="6.5" fill={C.violet} />)}
    {segs.map(s => <circle cx={s.x0 + BW * s.f} cy={s.y} r="5.5" fill={C.blue} />)}
  </svg>
</Fig>
