---
// 코드 만들기 위젯 — 근음과 코드 종류를 고르면 건반에 구성음을 칠하고 공식·음이름을 보여 주며 들려준다.
// config:
//   types      : 고를 코드 종류 id 목록 (lib/music.ts CHORD_TYPES)
//   root       : 처음 근음 (예 'C')
//   inversions : true면 자리바꿈(기본·1전위·2전위·3전위) 버튼 표시
//   title      : 헤더 제목
import { CHORD_TYPES, ROOTS, range, isBlack } from '../lib/music';
interface Props { config?: Record<string, any>; }
const { config = {} } = Astro.props;
const types: string[] = (config.types ?? ['maj', 'min']).filter((t: string) => CHORD_TYPES[t]);
const rootName = config.root ?? 'C';
const inv = !!config.inversions;
const title = config.title ?? '코드 만들기';
const keys = range(48, 83);
const whites = keys.filter(m => !isBlack(m));
const W = 100 / whites.length;
const blackLeft = (m: number) => (whites.indexOf(m - 1) + 1) * W - W * 0.3;
const seg = 'px-2 py-1.5 rounded-lg text-xs font-semibold transition-all text-[var(--color-ink-500)]';
---
<div class="chord-widget rounded-2xl border border-[var(--color-border)] bg-white overflow-hidden" data-root={rootName} data-type={types[0]}>
  <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg flex items-center justify-center gradient-brand">
        <svg class="text-white" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="7" cy="17" r="2.5"/><circle cx="12" cy="11" r="2.5"/><circle cx="17" cy="5" r="2.5"/></svg>
      </div>
      <div>
        <span class="font-bold text-base font-display">{title}</span>
        <span class="text-sm text-[var(--color-ink-300)] ml-2">Chord</span>
      </div>
    </div>
    <button type="button" class="play-btn shrink-0 whitespace-nowrap gradient-brand text-white text-sm font-semibold px-4 py-1.5 rounded-full transition hover:opacity-90 font-display">▶ 듣기</button>
  </div>
  <div class="p-5 space-y-4">
    <div class="rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-border)] px-4 py-3 text-center" aria-live="polite">
      <div class="c-sym text-3xl font-bold text-[var(--color-ink-700)] leading-tight font-display">C</div>
      <div class="c-kr text-xs text-[var(--color-ink-500)] mt-0.5">장3화음</div>
      <div class="c-notes text-sm font-mono text-[var(--color-violet)] mt-1">C · E · G</div>
      <div class="c-formula text-[11px] font-mono text-[var(--color-ink-300)] mt-0.5">1 · 3 · 5</div>
    </div>
    <div class="ckb relative select-none" style="height:110px">
      {whites.map((m, i) => <span class="ck white" data-midi={m} style={`left:${i * W}%;width:${W}%`}></span>)}
      {keys.filter(isBlack).map(m => <span class="ck black" data-midi={m} style={`left:${blackLeft(m)}%;width:${W * 0.6}%`}></span>)}
    </div>
    <div>
      <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink-300)] mb-1.5">근음<span class="label-en">Root</span></div>
      <div class="grid grid-cols-6 gap-1 p-1 bg-[var(--color-surface-2)] rounded-xl" role="group">
        {ROOTS.map(r => <button type="button" class={`root-btn ${seg}`} style="padding-left:0;padding-right:0" data-v={r.name} aria-pressed={r.name === rootName ? 'true' : 'false'}>{r.name}</button>)}
      </div>
    </div>
    {types.length > 1 && (
      <div>
        <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink-300)] mb-1.5">코드 종류<span class="label-en">Type</span></div>
        <div class="grid gap-1 p-1 bg-[var(--color-surface-2)] rounded-xl" style={`grid-template-columns:repeat(${Math.min(types.length, 4)},1fr)`} role="group">
          {types.map((t, i) => <button type="button" class={`type-btn ${seg}`} data-v={t} aria-pressed={i === 0 ? 'true' : 'false'}>{CHORD_TYPES[t].kr}</button>)}
        </div>
      </div>
    )}
    {inv && (
      <div>
        <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink-300)] mb-1.5">자리바꿈<span class="label-en">Inversion</span></div>
        <div class="grid grid-cols-4 gap-1 p-1 bg-[var(--color-surface-2)] rounded-xl" role="group">
          {['기본형', '1전위', '2전위', '3전위'].map((t, i) => <button type="button" class={`inv-btn ${seg}`} data-v={i} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>)}
        </div>
      </div>
    )}
  </div>
</div>

<style>
  .ckb .ck { position: absolute; top: 0; }
  .ckb .white { height: 100%; background: #fff; border: 1px solid var(--color-border); border-radius: 0 0 6px 6px; z-index: 1; }
  .ckb .black { height: 60%; background: #23232f; border-radius: 0 0 4px 4px; z-index: 2; }
  .ckb .white.hl { background: #c4b5fd; }
  .ckb .black.hl { background: #7c3aed; }
  .ckb .ck.bass { box-shadow: inset 0 -6px 0 #2563eb; }
  .ckb .ck.on { filter: brightness(.9); }
</style>

<script>
import { AudioCore } from '../audio/core';
import { playKey } from '../audio/keys';
import { CHORD_TYPES, ROOTS, chordNotes, LETTER_PC } from '../lib/music';

function initChord(root: HTMLElement) {
  let core: AudioCore | null = null;
  let rootN = root.dataset.root || 'C', typeId = root.dataset.type || 'maj', inv = 0;
  const sym = root.querySelector('.c-sym') as HTMLElement, kr = root.querySelector('.c-kr') as HTMLElement;
  const notesEl = root.querySelector('.c-notes') as HTMLElement, formula = root.querySelector('.c-formula') as HTMLElement;
  const invBtns = root.querySelectorAll<HTMLButtonElement>('.inv-btn');
  let midi: number[] = [];
  function apply() {
    const r = ROOTS.find(x => x.name === rootN)!, t = CHORD_TYPES[typeId];
    const sp = chordNotes(r, t);
    const rootPc = (LETTER_PC[r.letter] + r.acc + 12) % 12;
    const n = t.steps.length; if (inv >= n) inv = 0;
    invBtns.forEach((b, i) => { b.disabled = i >= n; b.style.opacity = i >= n ? '0.35' : ''; });
    const base = 60 + rootPc - (rootPc > 6 ? 12 : 0);       // 근음을 가운데 도 근처에
    let voiced = t.steps.map(s => base + s);
    for (let k = 0; k < inv; k++) { const lo = voiced.shift()!; voiced.push(lo + 12); }
    midi = voiced;
    const bassName = sp[inv % n].name;
    sym.textContent = `${r.name}${t.sym}${inv ? ` / ${bassName}` : ''}`;
    kr.textContent = `${t.kr}${inv ? ` · ${inv}전위 (${bassName}가 맨 아래)` : ''}`;
    notesEl.textContent = (inv ? [...sp.slice(inv), ...sp.slice(0, inv)] : sp).map(x => x.name).join(' · ');
    formula.textContent = t.formula;
    root.querySelectorAll('.ck').forEach(k => k.classList.remove('hl', 'bass'));
    midi.forEach((m, i) => { const k = root.querySelector(`.ck[data-midi="${m}"]`); k?.classList.add('hl'); if (i === 0) k?.classList.add('bass'); });
  }
  async function play() {
    core ??= new AudioCore(); await core.resume();
    const t = core.ctx.currentTime + 0.04;
    midi.forEach((m, i) => playKey(core!, m, t + i * 0.09, 1.0, 0.18));
    midi.forEach(m => playKey(core!, m, t + midi.length * 0.09 + 0.35, 1.6, 0.16));
  }
  const segSel = (cls: string, cb: (v: string) => void) => {
    const btns = root.querySelectorAll<HTMLButtonElement>(cls);
    const paint = (b: HTMLButtonElement) => { b.style.background = 'white'; b.style.color = 'var(--color-violet)'; b.style.boxShadow = '0 1px 4px rgba(0,0,0,0.08)'; };
    const clear = (b: HTMLButtonElement) => { b.style.background = ''; b.style.color = ''; b.style.boxShadow = ''; };
    btns.forEach(b => { if (b.getAttribute('aria-pressed') === 'true') paint(b);
      b.addEventListener('click', () => { if (b.disabled) return; btns.forEach(x => { x.setAttribute('aria-pressed', 'false'); clear(x); }); b.setAttribute('aria-pressed', 'true'); paint(b); cb(b.dataset.v!); play(); }); });
  };
  segSel('.root-btn', v => { rootN = v; apply(); });
  segSel('.type-btn', v => { typeId = v; apply(); });
  segSel('.inv-btn', v => { inv = Number(v); apply(); });
  root.querySelector('.play-btn')!.addEventListener('click', play);
  apply();
}
document.querySelectorAll<HTMLElement>('.chord-widget').forEach(initChord);
</script>
