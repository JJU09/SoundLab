---
import Base from '../../../layouts/Base.astro';
import SandboxShell from '../../../components/sandbox/SandboxShell.astro';
const base = import.meta.env.BASE_URL;
const tabs = [
  ['drums', '드럼'], ['chords', '코드'], ['bass', '베이스'], ['melody', '멜로디'], ['mix', '소리·믹스'],
];
---
<Base title="곡 스케치" description="드럼·코드·베이스·멜로디를 직접 찍어 벌스와 코러스 8마디 곡을 만들고 WAV로 저장하는 작곡 연습실. 설치 없이 브라우저에서."
  breadcrumbs={[{ name: '홈', url: base }, { name: '연습실', url: `${base}sandbox/` }, { name: '곡 스케치', url: Astro.url.pathname }]}>
<SandboxShell title="곡 스케치" en="Song Sketch"
  desc="드럼 → 코드 → 베이스 → 멜로디 순서로 벌스와 코러스 8마디를 채우고, 소리를 골라 WAV로 저장하세요. 예시 곡을 고쳐 가며 시작해도 좋아요."
  related={[
    { href: `${base}path/first-song/`, label: '로드맵 · 곡 하나 만들기' },
    { href: `${base}learn/rhythm/drum-patterns/`, label: '장르별 드럼 패턴' },
    { href: `${base}learn/harmony/progressions/`, label: '자주 쓰는 코드 진행' },
    { href: `${base}learn/melody/melody-writing/`, label: '멜로디 만들기' },
    { href: `${base}learn/arrangement/density/`, label: '편곡 밀도와 다이내믹' },
  ]}
  relatedNote="막히면 레슨으로 — 각 단계의 원리를 듣고 만지며 익힐 수 있어요.">

<div id="sk" class="sk space-y-4">

  <!-- 곡 설정 + 재생 -->
  <section class="p-4 rounded-2xl border border-[var(--color-border)] bg-white space-y-4">
    <div class="flex flex-wrap items-center gap-2">
      <input id="skTitle" class="font-display text-lg font-bold text-[var(--color-ink-700)] bg-transparent border-b border-dashed border-[var(--color-border)] focus:border-[var(--color-violet)] outline-none min-w-0 flex-1 basis-40 py-1" maxlength="40" aria-label="곡 제목" />
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="예시 곡">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-ink-300)] self-center mr-1">시작</span>
        <button type="button" class="sk-chip" data-ex="pop">팝</button>
        <button type="button" class="sk-chip" data-ex="ballad">발라드</button>
        <button type="button" class="sk-chip" data-ex="lofi">로파이</button>
        <button type="button" class="sk-chip" data-ex="blank">빈 스케치</button>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 items-end">
      <label class="sk-field"><span>조</span>
        <div class="flex gap-1.5"><select id="skKey" class="sk-select flex-1" aria-label="으뜸음"></select>
        <select id="skMode" class="sk-select" aria-label="장조 단조"><option value="major">장조</option><option value="minor">단조</option></select></div>
      </label>
      <label class="sk-field"><span>빠르기 <b id="skBpmVal" class="font-mono"></b></span><input id="skBpm" type="range" class="sl-range" min="50" max="180" step="1" aria-label="BPM" /></label>
      <label class="sk-field"><span>스윙 <b id="skSwingVal" class="font-mono"></b></span><input id="skSwing" type="range" class="sl-range" min="50" max="67" step="1" aria-label="스윙" /></label>
      <div class="flex gap-1.5 col-span-2 sm:col-span-1 justify-end">
        <button id="skPlay" type="button" class="flex-1 gradient-brand text-white font-semibold px-3 py-2.5 rounded-xl text-sm font-display whitespace-nowrap">▶ 전체 재생</button>
        <button id="skLoop" type="button" class="sk-btn whitespace-nowrap" title="편집 중인 섹션만 반복">🔁 <span id="skLoopLabel">벌스</span></button>
      </div>
    </div>
  </section>

  <!-- 구조: 섹션 × 마디 + 파트 켜기 -->
  <section class="p-4 rounded-2xl border border-[var(--color-border)] bg-white" id="skStructure">
    <div class="flex items-center justify-between mb-3 gap-2 flex-wrap">
      <h2 class="text-sm font-bold font-display text-[var(--color-ink-700)]">곡 구조 <span class="font-normal text-[var(--color-ink-300)] text-xs">— 섹션을 눌러 편집, 파트를 눌러 켜고 끄기</span></h2>
      <span id="skKeyName" class="text-xs font-mono text-[var(--color-ink-500)]"></span>
    </div>
    <div id="skOverview" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
  </section>

  <!-- 편집기 -->
  <section class="rounded-2xl border border-[var(--color-border)] bg-white overflow-hidden">
    <div class="flex items-center gap-1 p-2 border-b border-[var(--color-border)] bg-[var(--color-surface)] overflow-x-auto" role="tablist">
      {tabs.map(([id, label]) => <button type="button" role="tab" class="sk-tab" data-tab={id}>{label}</button>)}
      <span class="ml-auto text-xs text-[var(--color-ink-500)] whitespace-nowrap pl-2">편집 중: <b id="skSecName" class="text-[var(--color-violet)]"></b></span>
    </div>
    <div id="skPanel" class="p-4"></div>
  </section>

  <!-- 저장 -->
  <section class="p-4 rounded-2xl border border-[var(--color-border)] bg-white flex flex-wrap items-center gap-2">
    <button id="skWav" type="button" class="gradient-brand text-white font-semibold px-4 py-2.5 rounded-xl text-sm font-display">⬇ WAV로 저장</button>
    <button id="skShare" type="button" class="sk-btn">🔗 <span id="skShareLabel">링크 복사</span></button>
    <p class="text-xs text-[var(--color-ink-300)] basis-full sm:basis-auto sm:ml-2">작업은 이 브라우저에 자동 저장돼요. 링크에는 곡 전체가 담겨 서버에 저장되지 않아요.</p>
  </section>
</div>
</SandboxShell>
</Base>

<style is:global>
  .sk .sk-chip { font-size: 12px; font-weight: 600; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--color-border); color: var(--color-ink-500); background: white; transition: all .15s; }
  .sk .sk-chip:hover { border-color: var(--color-violet); color: var(--color-violet); }
  .sk .sk-chip.on { background: var(--color-violet); border-color: var(--color-violet); color: white; }
  .sk .sk-btn { font-size: 13px; font-weight: 600; padding: 9px 12px; border-radius: 12px; border: 1px solid var(--color-border); color: var(--color-ink-500); background: white; transition: all .15s; }
  .sk .sk-btn:hover, .sk .sk-btn.on { border-color: var(--color-violet); color: var(--color-violet); }
  .sk .sk-field { display: flex; flex-direction: column; gap: 6px; font-size: 11px; color: var(--color-ink-500); }
  .sk .sk-select { font-size: 13px; padding: 7px 8px; border-radius: 10px; border: 1px solid var(--color-border); background: white; color: var(--color-ink-700); }
  .sk .sk-tab { font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 10px; color: var(--color-ink-500); white-space: nowrap; }
  .sk .sk-tab.on { background: white; color: var(--color-violet); box-shadow: 0 1px 4px rgba(0,0,0,.08); }
  .sk .sk-seg { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: 12px; background: var(--color-surface-2); }
  .sk .sk-seg button { font-size: 12px; font-weight: 600; padding: 6px 11px; border-radius: 9px; color: var(--color-ink-500); }
  .sk .sk-seg button.on { background: white; color: var(--color-violet); box-shadow: 0 1px 4px rgba(0,0,0,.08); }
  .sk .sk-label { font-size: 10px; font-family: ui-monospace, monospace; text-transform: uppercase; letter-spacing: .06em; color: var(--color-ink-300); }
  /* 구조 */
  .sk .ov { border: 1px solid var(--color-border); border-radius: 14px; padding: 10px; cursor: pointer; transition: border-color .15s; }
  .sk .ov.sel { border-color: var(--color-violet); box-shadow: 0 0 0 3px var(--color-violet-glow); }
  .sk .ov-bars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin: 8px 0; }
  .sk .ov-bar { font-size: 12px; font-weight: 700; text-align: center; padding: 6px 2px; border-radius: 8px; background: var(--color-surface); color: var(--color-ink-700); transition: background .08s; }
  .sk .ov-bar.now { background: var(--color-violet); color: white; }
  .sk .ov-parts { display: flex; gap: 4px; flex-wrap: wrap; }
  .sk .ov-part { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--color-border); color: var(--color-ink-300); background: white; }
  .sk .ov-part.on { border-color: var(--color-violet-light); background: var(--color-violet-glow); color: var(--color-violet); }
  /* 격자 공통 */
  .sk .grid-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 4px; }
  .sk .gr { display: grid; gap: 2px; min-width: max-content; justify-content: start; }
  .sk .cell { width: 26px; height: 26px; border-radius: 5px; background: var(--color-surface-2); border: 0; padding: 0; transition: background .06s; }
  .sk .cell.beat { background: #e9e6f5; }
  .sk .cell.bar0 { margin-left: 6px; }
  .sk .cell.x { background: var(--color-violet); }
  .sk .cell.o { background: var(--color-violet-light); }
  .sk .cell.now { outline: 2px solid var(--color-blue); outline-offset: -2px; }
  .sk .grid-wrap .rowlab { position: sticky; left: 0; z-index: 1; background: white; }
  .sk .rowlab { font-size: 11px; font-weight: 600; color: var(--color-ink-500); display: flex; align-items: center; gap: 4px; padding-right: 6px; white-space: nowrap; background: none; border: 0; }
  .sk .mcell { width: 26px; height: 20px; border-radius: 4px; background: var(--color-surface-2); border: 0; padding: 0; }
  .sk .mcell.ct { background: #ddeee3; }
  .sk .mcell.dim { opacity: .35; }
  .sk .mcell.n { background: var(--color-violet); }
  .sk .mcell.h { background: var(--color-violet-light); }
  .sk .mcell.now { outline: 2px solid var(--color-blue); outline-offset: -2px; }
  .sk .mcell.bar0 { margin-left: 6px; }
  .sk .slot { border: 1px solid var(--color-border); border-radius: 12px; padding: 8px 4px; text-align: center; background: white; }
  .sk .slot.sel { border-color: var(--color-violet); box-shadow: 0 0 0 3px var(--color-violet-glow); }
  .sk .slot.now { background: var(--color-violet-glow); }
  .sk .pal { font-size: 12px; font-weight: 700; padding: 6px 10px; border-radius: 10px; border: 1px solid var(--color-border); background: white; color: var(--color-ink-700); min-width: 52px; }
  .sk .pal small { display: block; font-weight: 500; font-size: 10px; color: var(--color-ink-300); }
  .sk .pal:hover { border-color: var(--color-violet); }
  .sk .ov-bar b { display: block; font-family: 'Space Grotesk', 'Pretendard', sans-serif; font-size: 13px; line-height: 1.25; }
  .sk .ov-bar small { display: block; font-weight: 500; font-size: 10.5px; color: var(--color-ink-500); }
  .sk .ov-bar.now small { color: white; }
  /* 코드 탭 — 로마숫자 중심 */
  .sk .slot-rn { font-family: 'Space Grotesk', 'Pretendard', sans-serif; font-weight: 700; font-size: 22px; line-height: 1.25; color: var(--color-ink-700); }
  .sk .slot-nm { font-size: 12px; color: var(--color-ink-500); display: flex; gap: 5px; align-items: center; justify-content: center; }
  .sk .fdot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; flex: none; }
  .sk .fd-T, .sk .ft-T { background: #16a34a; } .sk .fd-S, .sk .ft-S { background: #2563eb; } .sk .fd-D, .sk .ft-D { background: #dc2626; }
  .sk .fd-B, .sk .ft-B { background: #9333ea; } .sk .fd-X, .sk .ft-X { background: #ea580c; }
  .sk .ch-layout { display: grid; gap: 20px; }
  @media (min-width: 900px) { .sk .ch-layout { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; } }
  .sk .fn-groups { display: grid; gap: 12px; }
  @media (min-width: 560px) { .sk .fn-groups { grid-template-columns: 3fr 2fr 2fr; } }
  .sk .fg-T { --fc: #16a34a; } .sk .fg-S { --fc: #2563eb; } .sk .fg-D { --fc: #dc2626; }
  .sk .fn-head { border-top: 2px solid var(--fc); padding-top: 6px; margin-bottom: 7px; display: flex; flex-direction: column; gap: 1px; }
  .sk .fn-head b { font-size: 12.5px; color: var(--fc); } .sk .fn-head span { font-size: 11px; color: var(--color-ink-500); }
  .sk .fn-btns { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 6px; }
  .sk .deg { border: 1px solid var(--color-border); border-radius: 12px; padding: 8px 2px 7px; background: white; text-align: center; min-width: 0; transition: border-color .12s, background .12s; }
  .sk .deg b { display: block; font-family: 'Space Grotesk', 'Pretendard', sans-serif; font-size: 19px; line-height: 1.25; color: var(--color-ink-700); }
  .sk .deg small { display: block; font-size: 11px; color: var(--color-ink-500); }
  .sk .deg:hover { border-color: var(--color-violet); }
  .sk .deg.on { border-color: var(--color-violet); background: #ede6fd; } .sk .deg.on b { color: var(--color-violet); }
  .sk .deg.wide { display: flex; align-items: baseline; gap: 8px; padding: 8px 12px; text-align: left; }
  .sk .deg.wide b { font-size: 15px; white-space: nowrap; }
  .sk .ch-detail { margin-top: 14px; padding: 12px 14px; border-radius: 12px; background: var(--color-surface); }
  .sk .ch-now { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .sk .ch-now b { font-size: 20px; color: var(--color-ink-700); } .sk .ch-now span { font-size: 14px; font-weight: 600; color: var(--color-ink-500); }
  .sk .fn-tag { font-style: normal; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; color: white; align-self: center; }
  .sk .ch-detail p { font-size: 13px; color: var(--color-ink-700); margin-top: 3px; }
  .sk .ch-extra { margin-top: 12px; border: 1px solid var(--color-border); border-radius: 12px; }
  .sk .ch-extra-head { width: 100%; display: flex; justify-content: space-between; gap: 8px; padding: 10px 14px; font-size: 12.5px; color: var(--color-ink-500); text-align: left; }
  .sk .ch-extra-head b { color: var(--color-ink-700); } .sk .ch-extra-head span:last-child { white-space: nowrap; }
  .sk .ch-extra-list { display: grid; gap: 6px; padding: 0 10px 10px; }
  @media (min-width: 560px) { .sk .ch-extra-list { grid-template-columns: 1fr 1fr; } }
  .sk .ch-circle svg { width: 100%; max-width: 380px; display: block; margin: 0 auto; }
  .sk .ch-circle p { font-size: 11.5px; line-height: 1.6; color: var(--color-ink-500); margin-top: 6px; }
  .sk .ch-circle p b { color: var(--color-ink-700); }
  .sk .cq text { font-family: 'Pretendard', sans-serif; } .sk .cq .cq-rn { font-family: 'Space Grotesk', 'Pretendard', sans-serif; }
  .sk .cq-node circle { transition: fill .08s; }
  .sk .cq-pick { cursor: pointer; outline: none; } .sk .cq-pick:hover circle { fill: #f8f8fc; }
  .sk .cq-node.now circle { fill: #ede6fd; stroke-width: 2.5; }
  .sk .cq-pick:focus-visible circle { stroke-width: 3; }
  .sk .sk-chip.prog b { font-family: 'Space Grotesk', 'Pretendard', sans-serif; color: var(--color-ink-700); margin-right: 6px; }
  .sk .sk-chip.prog:hover b { color: var(--color-violet); }
  .sk .fn-T { border-bottom: 3px solid #16a34a; } .sk .fn-S { border-bottom: 3px solid #2563eb; } .sk .fn-D { border-bottom: 3px solid #dc2626; }
  .sk .fn-B { border-bottom: 3px solid #9333ea; } .sk .fn-X { border-bottom: 3px solid #ea580c; }
</style>

<script>
import { EXAMPLES, cloneSong, blankSong, validate, encodeSong, decodeSong, keyOptions, keyName, chordInfo, rowLabels, rowMidi, FN_LABEL, FN_GROUPS, DEGREES, EXTRAS, PROGS, degreeOf,
  PARTS, PART_LABEL, SECTIONS, SECTION_LABEL, DRUM_TRACKS, BARS, STEPS, MEL_CELLS, MEL_ROWS, SEC_STEPS, REST, HOLD, PENTA_DEG, voice,
  type Song, type SectionId, type PartId } from '../../../lib/sketch';
import { SketchPlayer, renderWav } from '../../../audio/sketch';
import { PRESETS, TRACK_LABEL } from '../../../audio/drums';
import { midiName } from '../../../lib/music';
import { circleSvg } from '../../../lib/circle';

const STORE = 'sl-sketch-v1';
const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector(s) as T;
const esc = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

// ── 상태 ──
const params = new URLSearchParams(location.search);
let song: Song = (params.get('s') && decodeSong(params.get('s')!)) || (() => { try { const v = localStorage.getItem(STORE); return v ? validate(JSON.parse(v)) : null; } catch (e) { return null; } })() || cloneSong(EXAMPLES.pop.song);
let cur: SectionId = 'verse';
let tab = (['drums', 'chords', 'bass', 'melody', 'mix'] as const).includes(params.get('tab') as any) ? params.get('tab')! : 'drums';
let chordSlot = 0, pentaOnly = false, showCT = true, nowStep = -1, extraOpen = false;
let saveT = 0;
const changed = (redrawAll = false) => {
  clearTimeout(saveT); saveT = window.setTimeout(() => { try { localStorage.setItem(STORE, JSON.stringify(song)); } catch (e) {} }, 300);
  if (redrawAll) renderAll(); else { renderOverview(); }
};

const player = new SketchPlayer(() => song, g => { if (g >= 0 && !player.playing) return; nowStep = g; paintNow(); });

// ── 곡 설정 ──
const titleEl = $<HTMLInputElement>('#skTitle'), keyEl = $<HTMLSelectElement>('#skKey'), modeEl = $<HTMLSelectElement>('#skMode');
const bpmEl = $<HTMLInputElement>('#skBpm'), swEl = $<HTMLInputElement>('#skSwing');
const setPct = (el: HTMLInputElement) => el.style.setProperty('--sl-pct', ((+el.value - +el.min) / (+el.max - +el.min) * 100) + '%');
function renderHeader() {
  titleEl.value = song.title;
  keyEl.innerHTML = keyOptions(song.mode).map(k => `<option value="${k.pc}">${k.name}</option>`).join('');
  keyEl.value = String(song.key); modeEl.value = song.mode;
  bpmEl.value = String(song.bpm); $('#skBpmVal').textContent = song.bpm + ' BPM'; setPct(bpmEl);
  swEl.value = String(Math.round(song.swing * 100)); $('#skSwingVal').textContent = Math.round(song.swing * 100) + '%'; setPct(swEl);
  $('#skKeyName').textContent = keyName(song);
}
titleEl.addEventListener('input', () => { song.title = titleEl.value.slice(0, 40); changed(); });
keyEl.addEventListener('change', () => { song.key = +keyEl.value; $('#skKeyName').textContent = keyName(song); changed(true); });
modeEl.addEventListener('change', () => {
  const m = modeEl.value as Song['mode'];
  if (m === song.mode) return;
  // 장↔단 전환: 팔레트가 달라지므로 코드를 기본 진행으로 바꾸고 나란한조로 이동
  song.mode = m; song.key = (song.key + (m === 'minor' ? 9 : 3)) % 12;
  for (const id of SECTIONS) song.sections[id].chords = m === 'major' ? ['I', 'vi', 'IV', 'V'] : ['i', '♭VI', '♭III', '♭VII'];
  changed(true); renderHeader();
});
bpmEl.addEventListener('input', () => { song.bpm = +bpmEl.value; $('#skBpmVal').textContent = song.bpm + ' BPM'; setPct(bpmEl); changed(); });
swEl.addEventListener('input', () => { song.swing = +swEl.value / 100; $('#skSwingVal').textContent = swEl.value + '%'; setPct(swEl); changed(); });
document.querySelectorAll<HTMLElement>('[data-ex]').forEach(b => b.addEventListener('click', () => {
  const ex = b.dataset.ex!;
  song = ex === 'blank' ? blankSong() : cloneSong(EXAMPLES[ex].song);
  cur = 'verse'; chordSlot = 0; renderHeader(); changed(true);
}));

// ── 구조 개요 ──
function renderOverview() {
  $('#skOverview').innerHTML = SECTIONS.map(id => {
    const sec = song.sections[id];
    return `<div class="ov ${id === cur ? 'sel' : ''}" data-sec="${id}">
      <div class="flex items-center justify-between"><b class="text-sm font-display">${SECTION_LABEL[id]}</b><span class="sk-label">${id === 'verse' ? '1–4마디' : '5–8마디'}</span></div>
      <div class="ov-bars">${sec.chords.map((rn, i) => `<div class="ov-bar" data-bar="${id}-${i}">${rn ? `<b>${esc(rn)}</b><small>${esc(chordInfo(song, rn)?.name ?? '')}</small>` : '<b>—</b><small>쉼</small>'}</div>`).join('')}</div>
      <div class="ov-parts">${PARTS.map(p => `<button type="button" class="ov-part ${sec.on[p] ? 'on' : ''}" data-tog="${id}:${p}" aria-pressed="${sec.on[p]}">${PART_LABEL[p]}</button>`).join('')}</div>
    </div>`;
  }).join('');
  $('#skSecName').textContent = SECTION_LABEL[cur];
  $('#skLoopLabel').textContent = SECTION_LABEL[cur];
  paintNow();
}
$('#skOverview').addEventListener('click', e => {
  const t = e.target as HTMLElement;
  const tog = t.closest<HTMLElement>('[data-tog]');
  if (tog) { const [id, p] = tog.dataset.tog!.split(':') as [SectionId, PartId]; song.sections[id].on[p] = !song.sections[id].on[p]; changed(); return; }
  const ov = t.closest<HTMLElement>('[data-sec]');
  if (ov && ov.dataset.sec !== cur) { cur = ov.dataset.sec as SectionId; if (player.playing && player.range !== 'song') player.start(cur); renderOverview(); renderPanel(); }
});

// ── 탭 ──
document.querySelectorAll<HTMLElement>('.sk-tab').forEach(b => b.addEventListener('click', () => { tab = b.dataset.tab!; renderPanel(); }));

const seg = (name: string, opts: [string, string][], val: string) =>
  `<div class="sk-seg" data-seg="${name}">${opts.map(([v, l]) => `<button type="button" data-v="${v}" class="${v === val ? 'on' : ''}">${l}</button>`).join('')}</div>`;
const tip = (html: string) => `<p class="mt-4 text-xs leading-relaxed text-[var(--color-ink-500)] p-3 rounded-xl bg-[var(--color-surface)]">${html}</p>`;
const L = (path: string, label: string) => `<a class="text-[var(--color-violet)] font-semibold hover:underline" href="${import.meta.env.BASE_URL}learn/${path}/">${label}</a>`;

function renderPanel() {
  document.querySelectorAll<HTMLElement>('.sk-tab').forEach(b => b.classList.toggle('on', b.dataset.tab === tab));
  const sec = song.sections[cur];
  const SUBJ: Record<PartId, string> = { drums: '드럼이', bass: '베이스가', chords: '코드가', melody: '멜로디가' };
  const off = (p: PartId) => !sec.on[p] ? `<p class="mb-3 text-xs text-[var(--color-ink-500)]">⚠ ${SECTION_LABEL[cur]}에서 ${SUBJ[p]} 꺼져 있어요. 위 곡 구조에서 켜면 들려요.</p>` : '';
  let h = '';
  if (tab === 'drums') {
    const pre = ['rock8', 'pop16', 'ballad', 'house', 'boombap', 'shuffle'];
    h = off('drums') + `<div class="flex flex-wrap gap-1.5 mb-4"><span class="sk-label self-center mr-1">패턴</span>${pre.map(id => `<button type="button" class="sk-chip" data-preset="${id}">${PRESETS[id].name}</button>`).join('')}</div>
      <div class="grid-wrap"><div class="gr" style="grid-template-columns:auto repeat(16, 26px)">
      ${DRUM_TRACKS.map(tr => `<button type="button" class="rowlab" data-hear="${tr}" title="소리 듣기">🔈 ${TRACK_LABEL[tr]}</button>` +
        Array.from({ length: STEPS }, (_, s) => { const c = sec.drums[tr][s]; return `<button type="button" class="cell ${s % 4 === 0 ? 'beat' : ''} ${s && s % 4 === 0 ? '' : ''} ${c === 'x' ? 'x' : c === 'o' ? 'o' : ''}" data-d="${tr}:${s}" data-col="${s}" aria-label="${TRACK_LABEL[tr]} ${s + 1}번째 칸"></button>`; }).join('')).join('')}
      </div></div>
      <p class="mt-2 text-[11px] text-[var(--color-ink-300)]">한 마디 패턴이 4마디 동안 반복돼요. 칸을 누르면 침 → 약하게 → 쉼 순서로 바뀌어요.</p>`
      + tip(`처음엔 <b>스네어를 2·4박</b>(5번째·13번째 칸)에 두고, 킥으로 그루브를 만드세요. 코러스는 벌스보다 하이햇을 촘촘하게 하면 에너지가 올라가요. → ${L('rhythm/drum-patterns', '장르별 드럼 패턴')}`);
  } else if (tab === 'chords') {
    const ch = (rn: string) => rn ? chordInfo(song, rn) : null;
    const bar0 = cur === 'verse' ? 0 : 4;
    const curRn = sec.chords[chordSlot], curC = ch(curRn), curDeg = curRn ? degreeOf(song.mode, curRn) : null;
    const curExtra = curRn && !curDeg ? EXTRAS[song.mode].find(x => x.rn === curRn) : null;
    // 마디 칸: 로마숫자(조 안의 자리)가 주인공, 코드 이름은 작게
    const slots = `<div class="grid grid-cols-4 gap-2 mb-5">${sec.chords.map((rn, i) => { const c = ch(rn); return `<button type="button" class="slot ${i === chordSlot ? 'sel' : ''}" data-slot="${i}" data-barslot="${cur}-${i}">
        <div class="sk-label">${bar0 + i + 1}마디</div><div class="slot-rn">${c ? esc(rn) : '쉼'}</div><div class="slot-nm">${c ? `<i class="fdot fd-${c.fn}"></i>${esc(c.name)}` : '—'}</div></button>`; }).join('')}</div>`;
    // 조 안의 코드 7개를 기능별로
    const degBtn = (d: (typeof DEGREES)['major'][number]) => { const c = ch(d.rn)!, on = curDeg?.rn === d.rn;
      return `<button type="button" class="deg ${on ? 'on' : ''}" data-rn="${esc(on ? curRn : d.rn)}" aria-pressed="${on}"><b>${esc(d.rn)}</b><small>${esc(c.name)}</small></button>`; };
    const groups = `<div class="fn-groups">${FN_GROUPS.map(g => `<div class="fn-group fg-${g.fn}"><div class="fn-head"><b>${FN_LABEL[g.fn]}</b><span>${g.home} · ${g.desc}</span></div><div class="fn-btns">${DEGREES[song.mode].filter(d => d.fn === g.fn).map(degBtn).join('')}</div></div>`).join('')}</div>`;
    // 지금 고른 코드의 기능·분위기 + 같은 자리의 모양
    const detail = `<div class="ch-detail">${curC
      ? `<div class="ch-now"><b class="font-display">${esc(curRn)}</b><span>${esc(curC.name)}</span><em class="fn-tag ft-${curC.fn}">${FN_LABEL[curC.fn]}</em></div><p>${esc(curDeg?.mood ?? curExtra?.note ?? '')}</p>`
      : `<div class="ch-now"><b class="font-display">쉼</b></div><p>이 마디는 코드를 비워 둬요.</p>`}
      <div class="flex flex-wrap items-center gap-2 mt-2">${curDeg && curDeg.variants.length > 1 ? `<span class="sk-label">모양</span><div class="sk-seg">${curDeg.variants.map(([rn, l]) => `<button type="button" data-rn="${esc(rn)}" class="${rn === curRn ? 'on' : ''}">${l} · ${esc(ch(rn)!.name)}</button>`).join('')}</div>` : ''}${curRn ? `<button type="button" class="sk-chip" data-rn="">이 마디 비우기</button>` : ''}</div></div>`;
    const extras = `<div class="ch-extra"><button type="button" class="ch-extra-head" data-opt="extra" aria-expanded="${extraOpen}"><span><b>색다른 코드</b> — 조 밖에서 잠깐 가져오는 코드 ${EXTRAS[song.mode].length}개</span><span>${extraOpen ? '접기 ▴' : '펼치기 ▾'}</span></button>
      ${extraOpen ? `<div class="ch-extra-list">${EXTRAS[song.mode].map(x => { const c = ch(x.rn)!; return `<button type="button" class="deg wide ${x.rn === curRn ? 'on' : ''}" data-rn="${esc(x.rn)}"><b>${esc(x.rn)}</b><small>${esc(c.name)} · ${x.note}</small></button>`; }).join('')}</div>` : ''}</div>`;
    const circle = `<div class="ch-circle"><div class="sk-label mb-1">5도권에서 본 ${SECTION_LABEL[cur]} 진행</div>${circleSvg(song, sec.chords, { pickable: true })}
      <p>바깥 고리는 장3화음, 안쪽은 단3화음. 색칠한 부채꼴이 <b>${esc(keyName(song))}</b>의 코드예요. 가까운 자리끼리는 닮아서 부드럽게 이어지고, 멀리 뛰면 색다르게 들려요. 연한 화살표는 처음으로 돌아가는 길.</p></div>`;
    const progs = `<div class="mt-5"><div class="sk-label mb-2">진행 한 번에 넣기 — 네 마디를 채우고 고쳐 쓰세요</div><div class="flex flex-wrap gap-1.5">${PROGS[song.mode].map((p, i) => `<button type="button" class="sk-chip prog" data-prog="${i}"><b>${p.chords.map(esc).join(' – ')}</b>${p.note}</button>`).join('')}</div></div>`;
    h = off('chords') + slots
      + `<div class="ch-layout"><div><div class="sk-label mb-2">${bar0 + chordSlot + 1}마디에 넣을 코드 — ${esc(keyName(song))}</div>${groups}${detail}${extras}</div>${circle}</div>`
      + progs
      + `<div class="flex flex-wrap items-center gap-2 mt-5"><span class="sk-label">치는 방식</span>${seg('chordStyle', [['block', '블록'], ['arp', '분산화음'], ['stab', '스탭'], ['pad', '패드']], sec.chordStyle)}</div>`
      + tip(`<b>토닉</b>에서 시작해 <b>도미넌트</b>를 거쳐 돌아오면 안정적이에요. 같은 기능끼리는 바꿔 끼워도 흐름이 유지되고, 벌스와 코러스의 첫 코드를 다르게 하면 단락이 바뀌는 느낌이 나요. → ${L('harmony/progressions', '자주 쓰는 코드 진행')} · ${L('harmony/functions', '화성 기능')} · ${L('melody/circle-of-fifths', '조와 5도권')}`);
  } else if (tab === 'bass') {
    h = off('bass') + `<div class="flex flex-wrap items-center gap-2 mb-4"><span class="sk-label">리듬</span>${seg('bass', [['whole', '온음표'], ['eighth', '8분음표'], ['kick', '킥 따라가기'], ['octave', '옥타브']], sec.bass)}</div>
      <div class="grid grid-cols-4 gap-2">${sec.chords.map((rn, i) => { const c = rn ? chordInfo(song, rn) : null; return `<div class="slot" data-barslot="${cur}-${i}"><div class="sk-label">${(cur === 'verse' ? 0 : 4) + i + 1}마디</div><div class="text-base font-bold font-display">${c ? midiName(36 + c.rootPc, song.mode === 'minor' || [1, 3, 8, 10].includes(song.key) ? 'flat' : 'sharp', false) : '—'}</div><div class="text-[11px] text-[var(--color-ink-500)]">${c ? esc(c.name) + '의 근음' : '쉼'}</div></div>`; }).join('')}</div>`
      + tip(`베이스는 코드의 <b>근음</b>을 자동으로 따라가요. 리듬만 고르면 돼요. <b>킥 따라가기</b>는 킥이 치는 자리에 베이스를 맞춰 저음을 단단하게 붙여요. → ${L('arrangement/instrument-roles', '악기별 역할')}`);
  } else if (tab === 'melody') {
    const labels = rowLabels(song);
    const cells = BARS * MEL_CELLS;
    const penta = PENTA_DEG[song.mode];
    let grid = `<div class="gr" style="grid-template-columns:auto repeat(${cells}, 26px)">`;
    grid += `<span></span>` + Array.from({ length: cells }, (_, c) => { const bar = Math.floor(c / MEL_CELLS); const rn = sec.chords[bar]; const nm = rn && c % MEL_CELLS === 0 ? esc(chordInfo(song, rn)?.name ?? '') : ''; return `<span class="text-[10px] font-bold text-[var(--color-ink-500)] whitespace-nowrap ${c % MEL_CELLS === 0 && c ? 'pl-1.5' : ''}" style="${nm ? 'grid-column:span 1' : ''}">${nm}</span>`; }).join('');
    for (let r = MEL_ROWS - 1; r >= 0; r--) {
      const lab = labels[r];
      grid += `<button type="button" class="rowlab" data-hearrow="${r}">${lab.kr}<span class="text-[var(--color-ink-300)] font-mono text-[10px]">${lab.name}${"'".repeat(lab.oct)}</span></button>`;
      for (let c = 0; c < cells; c++) {
        const v = sec.melody[c];
        let owner = -1; if (v >= 0) owner = v; else if (v === HOLD) { let k = c; while (k > 0 && sec.melody[k] === HOLD) k--; owner = sec.melody[k]; }
        const bar = Math.floor(c / MEL_CELLS), rn = sec.chords[bar], ci = rn ? chordInfo(song, rn) : null;
        const strong = c % 4 === 0;
        const ct = showCT && strong && ci && ci.pcs.includes(rowMidi(song, r) % 12);
        const dim = pentaOnly && !penta.includes(r % 7);
        const cls = owner === r ? (v >= 0 ? 'n' : 'h') : (ct ? 'ct' : '');
        grid += `<button type="button" class="mcell ${cls} ${dim && owner !== r ? 'dim' : ''} ${c % MEL_CELLS === 0 && c ? 'bar0' : ''}" data-m="${r}:${c}" data-col="${c * 2}" aria-label="${lab.kr} ${c + 1}번째 칸"></button>`;
      }
    }
    grid += '</div>';
    h = off('melody') + `<div class="flex flex-wrap items-center gap-2 mb-3">
        <button type="button" class="sk-chip ${pentaOnly ? 'on' : ''}" data-opt="penta">펜타토닉만</button>
        <button type="button" class="sk-chip ${showCT ? 'on' : ''}" data-opt="ct">센 박 코드 톤 표시</button>
        <button type="button" class="sk-chip" data-opt="copy">${SECTION_LABEL[cur === 'verse' ? 'chorus' : 'verse']} 멜로디 복사</button>
        <button type="button" class="sk-chip" data-opt="clear">지우기</button></div>
      <div class="grid-wrap">${grid}</div>
      <p class="mt-2 text-[11px] text-[var(--color-ink-300)]">칸 = 8분음표. 빈 칸을 누르면 음이 생기고, 바로 오른쪽 칸을 누르면 길게 이어져요. 음을 다시 누르면 지워져요. 연한 초록 칸은 센 박의 코드 구성음이에요.</p>`
      + tip(`짧은 모티브를 만들고 반복·변형하세요. 센 박에는 초록 칸(코드 톤)을, 마지막 음은 <b>${labels[0].kr}</b>(으뜸음)로 끝내면 "끝났다"는 느낌이 나요. → ${L('melody/melody-writing', '멜로디 만들기')} · ${L('melody/pentatonic', '펜타토닉')}`);
  } else {
    const instRow = (p: 'chords' | 'bass' | 'melody', opts: [string, string][]) =>
      `<div class="flex flex-wrap items-center gap-2"><span class="w-14 text-sm font-semibold text-[var(--color-ink-700)]">${PART_LABEL[p]}</span>${seg('inst-' + p, opts, song.inst[p])}</div>`;
    h = `<div class="grid gap-6 md:grid-cols-2">
      <div class="space-y-3"><div class="sk-label">음색</div>
        ${instRow('chords', [['keys', '피아노'], ['pad', '패드'], ['pluck', '플럭']])}
        ${instRow('bass', [['sub', '서브'], ['synth', '신스'], ['pluck', '퉁기기']])}
        ${instRow('melody', [['soft', '부드럽게'], ['bright', '밝게'], ['bell', '벨']])}
      </div>
      <div class="space-y-3"><div class="sk-label">볼륨</div>
        ${PARTS.map(p => `<label class="flex items-center gap-3 text-sm"><span class="w-14 font-semibold text-[var(--color-ink-700)]">${PART_LABEL[p]}</span><input type="range" class="sl-range flex-1" min="0" max="100" value="${song.vol[p]}" data-vol="${p}" aria-label="${PART_LABEL[p]} 볼륨"/><span class="w-8 text-right font-mono text-xs text-[var(--color-ink-500)]" data-volval="${p}">${song.vol[p]}</span></label>`).join('')}
      </div></div>`
      + tip(`멜로디가 가장 잘 들리게, 킥과 베이스는 서로 가리지 않게 맞춰 보세요. 마스터에는 컴프레서와 리미터가 걸려 있어 저장한 WAV가 0dBFS를 넘지 않아요. → ${L('mixing/balance', '볼륨 밸런스')} · ${L('synthesis/subtractive', '감산합성')} · ${L('mixing/export', '내보내기와 포맷')}`);
  }
  $('#skPanel').innerHTML = h;
  $('#skPanel').querySelectorAll<HTMLInputElement>('input[type=range]').forEach(setPct);
  paintNow();
}

// ── 패널 이벤트 (위임) ──
const panel = $('#skPanel');
panel.addEventListener('click', e => {
  const t = (e.target as HTMLElement).closest<HTMLElement>('button,[data-rn]');
  if (!t) return;
  const sec = song.sections[cur];
  if (t.dataset.preset) { const p = PRESETS[t.dataset.preset]; for (const tr of DRUM_TRACKS) sec.drums[tr] = (p.tracks as any)[tr] ?? '................'; if (p.swing) { song.swing = p.swing; renderHeader(); } changed(); renderPanel(); return; }
  if (t.dataset.d) { const [tr, s] = t.dataset.d.split(':'); const row = sec.drums[tr as keyof typeof sec.drums]; const c = row[+s]; const nx = c === '.' ? 'x' : c === 'x' ? 'o' : '.'; sec.drums[tr as keyof typeof sec.drums] = row.slice(0, +s) + nx + row.slice(+s + 1); t.classList.toggle('x', nx === 'x'); t.classList.toggle('o', nx === 'o'); if (nx !== '.') player.previewDrum(tr as any); changed(); return; }
  if (t.dataset.hear) { player.previewDrum(t.dataset.hear as any); return; }
  if (t.dataset.slot) { chordSlot = +t.dataset.slot; renderPanel(); return; }
  if (t.dataset.rn !== undefined) {
    sec.chords[chordSlot] = t.dataset.rn; const c = chordInfo(song, t.dataset.rn);
    if (c) voice(c.pcs).forEach((m, i) => setTimeout(() => player.preview('chords', m), i * 25));
    if (t.dataset.rn && !degreeOf(song.mode, t.dataset.rn)) extraOpen = true;
    changed(); renderPanel(); return;
  }
  if (t.dataset.prog) { sec.chords = [...PROGS[song.mode][+t.dataset.prog].chords]; chordSlot = 0; changed(); renderPanel(); return; }
  if (t.dataset.opt === 'extra') { extraOpen = !extraOpen; renderPanel(); return; }
  if (t.dataset.hearrow) { player.preview('melody', rowMidi(song, +t.dataset.hearrow)); return; }
  if (t.dataset.m) {
    const [r, c] = t.dataset.m.split(':').map(Number); const m = sec.melody;
    const ownerOf = (k: number) => { if (m[k] >= 0) return m[k]; if (m[k] === HOLD) { let j = k; while (j > 0 && m[j] === HOLD) j--; return m[j]; } return REST; };
    const clearFrom = (k: number) => { m[k] = REST; let j = k + 1; while (j < m.length && m[j] === HOLD) { m[j] = REST; j++; } };
    if (m[c] === r) clearFrom(c);                                  // 시작 칸을 다시 누름 → 삭제
    else if (m[c] === HOLD && ownerOf(c) === r) clearFrom(c);      // 이어진 칸을 누름 → 거기부터 자름
    else if (c > 0 && m[c] === REST && ownerOf(c - 1) === r) m[c] = HOLD; // 바로 오른쪽 → 이어 붙이기
    else { if (m[c] === HOLD || m[c] >= 0) clearFrom(c); m[c] = r; let j = c + 1; while (j < m.length && m[j] === HOLD) { m[j] = REST; j++; } player.preview('melody', rowMidi(song, r)); }
    if (m[c] === HOLD && c === 0) m[c] = REST;
    changed(); renderPanel(); return;
  }
  if (t.dataset.opt === 'penta') { pentaOnly = !pentaOnly; renderPanel(); return; }
  if (t.dataset.opt === 'ct') { showCT = !showCT; renderPanel(); return; }
  if (t.dataset.opt === 'copy') { sec.melody = [...song.sections[cur === 'verse' ? 'chorus' : 'verse'].melody]; changed(); renderPanel(); return; }
  if (t.dataset.opt === 'clear') { sec.melody = Array(BARS * MEL_CELLS).fill(REST); changed(); renderPanel(); return; }
  const sg = t.closest<HTMLElement>('[data-seg]');
  if (sg && t.dataset.v) {
    const name = sg.dataset.seg!, v = t.dataset.v;
    if (name === 'chordStyle') sec.chordStyle = v as any;
    else if (name === 'bass') sec.bass = v as any;
    else if (name.startsWith('inst-')) { const p = name.slice(5) as 'chords' | 'bass' | 'melody'; (song.inst as any)[p] = v; const mid = p === 'bass' ? 40 : p === 'chords' ? 64 : 72; player.preview(p, mid); }
    sg.querySelectorAll('button').forEach(b => b.classList.toggle('on', b === t));
    changed(); return;
  }
});
// 5도권의 코드 자리는 키보드로도 고를 수 있게
panel.addEventListener('keydown', e => {
  const n = (e.target as HTMLElement).closest<HTMLElement>('.cq-pick');
  if (n && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); n.dispatchEvent(new MouseEvent('click', { bubbles: true })); }
});
panel.addEventListener('input', e => {
  const t = e.target as HTMLInputElement;
  if (t.dataset.vol) { song.vol[t.dataset.vol as PartId] = +t.value; setPct(t); panel.querySelector(`[data-volval="${t.dataset.vol}"]`)!.textContent = t.value; changed(); }
});

// ── 재생 위치 표시 ──
function paintNow() {
  document.querySelectorAll('.now').forEach(el => el.classList.remove('now'));
  if (nowStep < 0) return;
  const id = SECTIONS[Math.floor(nowStep / SEC_STEPS)], local = nowStep % SEC_STEPS, bar = Math.floor(local / STEPS), s = local % STEPS;
  document.querySelector(`.ov-bar[data-bar="${id}-${bar}"]`)?.classList.add('now');
  document.querySelector(`.slot[data-barslot="${id}-${bar}"]`)?.classList.add('now');
  if (id !== cur) return;
  if (tab === 'chords') document.querySelectorAll(`.cq-node[data-bars~="${bar}"]`).forEach(el => el.classList.add('now'));
  if (tab === 'drums') document.querySelectorAll(`.cell[data-col="${s}"]`).forEach(el => el.classList.add('now'));
  if (tab === 'melody' && s % 2 === 0) document.querySelectorAll(`.mcell[data-col="${bar * 16 + s}"]`).forEach(el => el.classList.add('now'));
}

// ── 재생 버튼 ──
const playBtn = $('#skPlay'), loopBtn = $('#skLoop');
const syncBtns = () => {
  playBtn.textContent = player.playing && player.range === 'song' ? '■ 정지' : '▶ 전체 재생';
  loopBtn.classList.toggle('on', player.playing && player.range !== 'song');
};
playBtn.addEventListener('click', async () => { if (player.playing && player.range === 'song') player.stop(); else await player.start('song'); syncBtns(); });
loopBtn.addEventListener('click', async () => { if (player.playing && player.range !== 'song') player.stop(); else await player.start(cur); syncBtns(); });
document.addEventListener('keydown', e => { if (e.code === 'Space' && !(e.target as HTMLElement).closest('input,select,textarea,.cq-pick')) { e.preventDefault(); playBtn.click(); } });

// ── 저장 · 공유 ──
const wavBtn = $<HTMLButtonElement>('#skWav');
wavBtn.addEventListener('click', async () => {
  wavBtn.disabled = true; const old = wavBtn.textContent; wavBtn.textContent = '만드는 중…';
  try {
    const blob = await renderWav(song);
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
    a.download = `${(song.title || '내 스케치').replace(/[\\/:*?"<>|]/g, '_')}_${song.bpm}bpm.wav`;
    document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    try { (window as any).gtag?.('event', 'sketch_wav', { bpm: song.bpm }); } catch (e) {}
    wavBtn.textContent = '저장됨 ✓';
  } catch (e) { wavBtn.textContent = '저장 실패 — 다시 시도'; }
  setTimeout(() => { wavBtn.textContent = old; wavBtn.disabled = false; }, 1800);
});
$('#skShare').addEventListener('click', async () => {
  const url = new URL(location.href); url.search = ''; url.searchParams.set('s', encodeSong(song));
  history.replaceState(null, '', url);
  let ok = false; try { await navigator.clipboard.writeText(url.toString()); ok = true; } catch (e) {}
  const lab = $('#skShareLabel'); lab.textContent = ok ? '복사됨 ✓' : '주소창 링크를 복사하세요';
  setTimeout(() => { lab.textContent = '링크 복사'; }, 2000);
});

function renderAll() { renderOverview(); renderPanel(); }
renderHeader(); renderAll(); syncBtns();
if (params.get('tab') === 'structure') $('#skStructure').scrollIntoView({ block: 'center' });
</script>
