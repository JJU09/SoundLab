---
// 정적 건반 그림 — 음(MIDI)별 강조 그룹
import Fig from './Fig.astro'; import { C } from './colors';
import { midiName } from '../../../lib/music';
type Col = keyof typeof C;
interface Group { notes: number[]; color: Col; label: string; names?: Record<number, string>; }
interface Props { from?: number; to?: number; groups: Group[]; caption?: string; label: string; }
const { from = 60, to = 72, groups, caption, label } = Astro.props as Props;
const isBlack = (m: number) => [1, 3, 6, 8, 10].includes(m % 12);
const WW = 40, WH = 130, BWd = 24, BH = 80, L = 6, top = 6;
const all: number[] = []; for (let m = from; m <= to; m++) all.push(m);
const whites = all.filter(m => !isBlack(m));
const wx = new Map<number, number>(); whites.forEach((m, i) => wx.set(m, L + i * WW));
const info = (m: number) => { const g = groups.find(g => g.notes.includes(m)); return g ? { fill: C[g.color], name: g.names?.[m] ?? midiName(m, 'flat', false) } : null; };
const wk = whites.map(m => ({ x: wx.get(m)!, h: info(m) }));
const bk = all.filter(isBlack).map(m => ({ x: wx.get(m - 1)! + WW - BWd / 2 - 1, h: info(m) }));
const W = L * 2 + whites.length * WW, H = top + WH + 12 + groups.length * 18;
const legend = groups.map((g, i) => ({ x: L, y: top + WH + 12 + i * 18, fill: C[g.color], label: g.label }));
---
<Fig caption={caption} minW={300} maxW={460} label={label}>
  <svg viewBox={`0 0 ${W} ${H}`}>
    {wk.map(k => <rect x={k.x} y={top} width={WW - 2} height={WH} rx="4" fill={k.h ? k.h.fill : 'white'} fill-opacity={k.h ? 0.75 : 1} stroke={C.line} />)}
    {wk.filter(k => k.h).map(k => <text x={k.x + 19} y={top + WH - 10} text-anchor="middle" font-size="12" class="fd" fill="white">{k.h!.name}</text>)}
    {bk.map(k => <rect x={k.x} y={top} width={BWd} height={BH} rx="3" fill={k.h ? k.h.fill : C.ink} />)}
    {bk.filter(k => k.h).map(k => <text x={k.x + 12} y={top + BH - 8} text-anchor="middle" font-size="10" class="fd" fill="white">{k.h!.name}</text>)}
    {legend.map(l => <rect x={l.x} y={l.y} width="12" height="12" rx="3" fill={l.fill} />)}
    {legend.map(l => <text x={l.x + 18} y={l.y + 10} font-size="11" fill={C.ink5}>{l.label}</text>)}
  </svg>
</Fig>
