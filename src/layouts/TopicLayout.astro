---
import Base from './Base.astro';
import TopicWidget from '../components/TopicWidget.astro';
import Quiz from '../components/Quiz.astro';
import ScaffoldBar from '../components/ScaffoldBar.astro';
import AdUnit from '../components/AdUnit.astro';
import { HUB_META, SANDBOX_OF } from '../content.config';
import { QUIZZES } from '../lib/quizzes';
import { pathPositions } from '../lib/paths';
import { getCollection } from 'astro:content';

interface TopicData {
  hub: keyof typeof HUB_META;
  title: string;
  kr: string;
  order: number;
  color: 'violet' | 'blue';
  tagline: string;
  desc: string;
  widget: string;
  widgetConfig?: Record<string, any>;
  quiz?: string;
  scaffold?: boolean;
  prereqs?: string[];
}
interface NavLink { slug: string; title: string; kr: string; }

interface Props {
  data: TopicData;
  prev?: NavLink | null;
  next?: NavLink | null;
}
const { data, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const hub = HUB_META[data.hub];
const sandbox = SANDBOX_OF[data.hub]; // 허브 연습실 크로스링크 (학습→자유 실험 동선)
const hasWidget = data.widget && data.widget !== 'none';
const quiz = data.quiz ? QUIZZES[data.quiz] : null;
const num = String(data.order).padStart(2, '0');
// 먼저 알면 좋은 개념 — 존재하는 토픽만 링크 (아직 없는 토픽은 이름 없이 건너뜀)
const allTopics = await getCollection('topics'); // prereq·로드맵 링크 공용 (빌드 시 캐시됨)
const prereqLinks = (data.prereqs ?? []).map(id => {
  const t = allTopics.find(x => x.id === id && !x.data.draft);
  return t ? { href: `${base}learn/${id}/`, title: t.data.title, kr: t.data.kr } : null;
}).filter((x): x is { href: string; title: string; kr: string } => !!x);
// 학습 경로 위치 — 이 레슨이 경로의 핵심 레슨이면 "경로에서 다음 레슨" 카드 표시
const topicId = Astro.url.pathname.replace(base, '').replace(/^learn\//, '').replace(/\/$/, '');
const positions = pathPositions(topicId).map(p => {
  const n = p.next ? allTopics.find(t => t.id === p.next) : null;
  return { ...p, nextInfo: n ? { href: `${base}learn/${p.next}/`, title: n.data.title, kr: n.data.kr } : null };
});
const accent = data.color === 'violet'
  ? 'border-[var(--color-violet-light)] text-[var(--color-violet)] bg-[var(--color-violet-glow)]'
  : 'border-[var(--color-blue-light)] text-[var(--color-blue)] bg-[var(--color-blue-glow)]';
---
<Base title={`${data.kr} (${data.title})`} description={data.desc} type="article"
  breadcrumbs={[
    { name: '홈', url: base },
    { name: hub.kr, url: `${base}learn/${data.hub}/` },
    { name: data.title, url: Astro.url.pathname },
  ]}>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">

    <!-- 브레드크럼 -->
    <nav class="flex items-center gap-2 text-xs font-mono text-[var(--color-ink-300)] mb-8">
      <a href={base} class="hover:text-[var(--color-violet)] transition">홈</a>
      <span>/</span>
      <a href={`${base}learn/${data.hub}/`} class="hover:text-[var(--color-violet)] transition">{hub.kr}</a>
      <span>/</span>
      <span class="text-[var(--color-ink-700)]">{data.kr}</span>
    </nav>

    <div {...(data.scaffold ? { 'data-scaffold': '', 'data-level': 'normal' } : {})}>
    {data.scaffold && (
      // 페인트 전 저장된 난이도를 미리 적용해 normal 깜빡임(FOUC) 제거. 기본값은 normal 유지.
      <script is:inline>
        (function () {
          try {
            var L = localStorage.getItem('sl-level');
            if (L === 'easy' || L === 'hard') document.currentScript.parentElement.setAttribute('data-level', L);
          } catch (e) {}
        })();
      </script>
    )}
    {data.scaffold && <ScaffoldBar />}
    <div class={`grid grid-cols-1 gap-10 ${hasWidget ? 'lg:grid-cols-[1fr_380px]' : ''}`}>

      <!-- 왼쪽: 개념 설명 -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class={`text-xs font-mono px-2.5 py-1 rounded-full border ${accent}`}>
            {hub.kr}<span class="label-en">{hub.label}</span> · {num}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold mb-2 leading-tight font-display">
          {data.kr}
          <span class="text-[var(--color-ink-300)] font-medium text-xl ml-2">{data.title}</span>
        </h1>
        <p class={`text-lg font-medium mb-6 ${data.color === 'violet' ? 'gradient-brand-text' : ''}`}
          style={data.color === 'blue' ? 'color:var(--color-blue)' : ''}>
          {data.tagline}
        </p>

        <p class="text-[var(--color-ink-700)] leading-relaxed mb-8">{data.desc}</p>

        {prereqLinks.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 -mt-4 mb-8 text-sm">
            <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink-300)]">먼저 알면 좋아요</span>
            {prereqLinks.map(p => (
              <a href={p.href} class="px-2.5 py-1 rounded-full border border-[var(--color-border)] text-[var(--color-ink-700)] hover:border-[var(--color-violet)] hover:text-[var(--color-violet)] transition">{p.kr}</a>
            ))}
          </div>
        )}

        <!-- MDX 본문 -->
        <div class="topic-body space-y-6 text-sm leading-relaxed text-[var(--color-ink-700)]">
          <slot />
        </div>

        <!-- 객관식 퀴즈 -->
        {quiz && <Quiz questions={quiz} color={data.color} />}

        <!-- 학습 경로 — 허브를 가로지르는 다음 레슨 -->
        {positions.map(p => (
          <div class="mt-10 p-5 rounded-2xl border border-[var(--color-violet-light)] bg-[var(--color-violet-glow)]">
            <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
              <a href={`${base}path/${p.path.id}/`} class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-violet)] hover:underline">
                로드맵 · {p.path.kr} · {p.stageIdx}단계 {p.stage.title}
              </a>
              <span class="text-[10px] font-mono text-[var(--color-ink-500)]">{p.step} / {p.total}</span>
            </div>
            <div class="h-1.5 rounded-full bg-white overflow-hidden mb-4"><div class="h-full gradient-brand" style={`width:${Math.round(p.step / p.total * 100)}%`}></div></div>
            {p.nextInfo ? (
              <a href={p.nextInfo.href} class="group flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="text-xs text-[var(--color-ink-500)]">{p.nextStage ? `다음 단계 · ${p.nextStage.title}` : '로드맵 다음 레슨'}</div>
                  <div class="font-bold text-[var(--color-ink-700)] group-hover:text-[var(--color-violet)] transition font-display">{p.nextInfo.kr} <span class="font-medium text-[var(--color-ink-300)]">{p.nextInfo.title}</span></div>
                </div>
                <span class="shrink-0 whitespace-nowrap gradient-brand text-white text-sm font-semibold px-4 py-2 rounded-xl">다음 →</span>
              </a>
            ) : (
              <a href={`${base}path/${p.path.id}/`} class="group flex items-center justify-between gap-3">
                <div class="font-bold text-[var(--color-ink-700)] font-display">로드맵의 마지막 레슨이에요. 단계별 체크리스트로 곡을 점검해 보세요.</div>
                <span class="shrink-0 whitespace-nowrap gradient-brand text-white text-sm font-semibold px-4 py-2 rounded-xl">로드맵 보기</span>
              </a>
            )}
          </div>
        ))}

        <!-- 샌드박스 크로스링크 — 배운 개념을 자유롭게 실험 -->
        {sandbox && (
          <a href={`${base}${sandbox.path}`}
            class="group flex items-center gap-4 mt-10 p-5 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-violet)] hover:shadow-lg transition-all">
            <div class="w-11 h-11 flex-none rounded-xl gradient-brand flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 3v18M5 12h14M19 3v18M9 7h.01M15 17h.01"/></svg>
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-violet)]">연습실 · 직접 실험</div>
              <div class="font-bold text-[var(--color-ink-700)] group-hover:text-[var(--color-violet)] transition font-display">{sandbox.name}에서 자유롭게 실험해보기</div>
              <p class="text-sm text-[var(--color-ink-500)] mt-0.5">{hub.kr} 레슨에서 배운 요소를 직접 조합하며 소리를 만들어 보세요.</p>
            </div>
            <svg class="w-5 h-5 flex-none text-[var(--color-ink-300)] group-hover:text-[var(--color-violet)] group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        )}

        <!-- 이전/다음 -->
        <div class="flex items-center justify-between mt-12 pt-8 border-t border-[var(--color-border)]">
          {prev ? (
            <a href={`${base}learn/${data.hub}/${prev.slug}/`}
              class="flex items-center gap-2 text-sm font-medium text-[var(--color-ink-500)] hover:text-[var(--color-violet)] transition group">
              <svg class="w-4 h-4 transition group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              <div>
                <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-ink-300)]">이전</div>
                <div>{prev.kr}<span class="label-en">{prev.title}</span></div>
              </div>
            </a>
          ) : <div />}

          {next ? (
            <a href={`${base}learn/${data.hub}/${next.slug}/`}
              class="flex items-center gap-2 text-sm font-medium text-[var(--color-ink-500)] hover:text-[var(--color-violet)] transition group text-right">
              <div>
                <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-ink-300)]">다음</div>
                <div>{next.kr}<span class="label-en">{next.title}</span></div>
              </div>
              <svg class="w-4 h-4 transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          ) : <div />}
        </div>
      </div>

      <!-- 오른쪽: 인터랙티브 위젯 -->
      {hasWidget && (
        <div class="lg:sticky lg:top-20 self-start">
          <TopicWidget widget={data.widget} config={data.widgetConfig} />
        </div>
      )}

    </div>
    </div>

    <AdUnit />
    <!-- 읽은 레슨 기록 (학습 경로 진행 표시용, 이 브라우저에만 저장) -->
    <script is:inline define:vars={{ topicId }}>
      try {
        var k = 'sl-visited', v = JSON.parse(localStorage.getItem(k) || '[]');
        if (v.indexOf(topicId) < 0) { v.push(topicId); localStorage.setItem(k, JSON.stringify(v)); }
      } catch (e) {}
    </script>
  </div>
</Base>
