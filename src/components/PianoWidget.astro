---
// 건반 위젯 — 누르면 소리가 나고 음이름을 보여준다. 음악 영역(악보·리듬·음계·화성) 레슨 공용.
// config:
//   from / to   : 표시 범위 (기본 C4 ~ B5, 두 옥타브)
//   labels      : 'kr'(도레미, 다장조 기준) | 'en'(CDE) | 'both' | 'none'  (사용자가 위젯에서 바꿀 수 있음)
//   highlight   : 강조할 음 목록 (예: ["C4","E4","G4"]) — 음계·코드 레슨에서 사용
//   title       : 헤더 제목 (기본 "건반")
//   mode        : 'free'(기본) | 'interval'(두 건반 사이 음정) | 'scale'(으뜸음·음계를 골라 강조·재생)
//   scales      : scale 모드에서 고를 음계 id 목록 (lib/music.ts SCALES), root: 처음 으뜸음 이름 (예 'C')
//   mode 'walk' : 화살표로 상태를 한 칸씩 넘기며 음계를 비교한다. 넘길 때마다 음 하나가 바뀌는 순서로 둔다.
//     walk.by 'root'  → scales[0] 음계를 으뜸음 roots(기본: 5도권 순서 G♭~F♯)로 넘김
//     walk.by 'scale' → root에서 scales 순서로 넘김
//     walk.home: 기준 상태(이 상태에서 멀어지는 쪽으로 바뀐 음을 보라로), walk.gaps: 온·반 줄, walk.circle: 모드 창 5도권
//   mode 'keysig': 조를 고르면 그 조의 일곱 음을 건반에 칠하고 조표를 오선으로 보여 준다. key: 처음 조 (예 'G')
import { parseNote, range, isBlack, midiName, solfegeName, SCALES, ROOTS } from '../lib/music';
interface Props { config?: Record<string, any>; }
const { config = {} } = Astro.props;
const lo = parseNote(config.from ?? 'C4')?.midi ?? 60;
const hi = parseNote(config.to ?? 'B5')?.midi ?? 83;
const labels: string = config.labels ?? 'both';
const highlight: number[] = (config.highlight ?? []).map((s: string) => parseNote(s)?.midi).filter((m: any) => m != null);
const title: string = config.title ?? '건반';
const mode: string = config.mode ?? 'free';
const scaleIds: string[] = (config.scales ?? ['major']).filter((id: string) => SCALES[id]);
const rootName: string = config.root ?? 'C';
const seg = 'px-2 py-1.5 rounded-lg text-xs font-semibold transition-all text-[var(--color-ink-500)]';
const keys = range(lo, hi);
const whites = keys.filter(m => !isBlack(m));
const W = 100 / whites.length; // 흰 건반 폭(%)
// 검은 건반 위치: 왼쪽 흰 건반의 오른쪽 끝에 중심
const blackLeft = (m: number) => (whites.indexOf(m - 1) + 1) * W - W * 0.3;
const labelOpts: [string, string][] = [['kr', '도레미'], ['en', 'CDE'], ['both', '둘 다'], ['none', '숨김']];
// keysig 모드: 5도권 순서(조표 ♭7 → ♯7). 화살표로 한 칸씩 넘긴다.
const KEYSIG_ORDER = ['G♭', 'D♭', 'A♭', 'E♭', 'B♭', 'F', 'C', 'G', 'D', 'A', 'E', 'B', 'F♯'];
// 5도권: 12칸(C가 0, 시계 방향 = ♯ 쪽). G♭과 F♯은 같은 칸.
const CIRCLE = ['C', 'G', 'D', 'A', 'E', 'B', 'F♯/G♭', 'D♭', 'A♭', 'E♭', 'B♭', 'F'];
const CR = 52, CC = 70;
const cpt = (i: number) => { const a = (i * 30 - 90) * Math.PI / 180; return [CC + CR * Math.cos(a), CC + CR * Math.sin(a)]; };
const keyName: string = config.key ?? 'G';
const clean = mode === 'keysig' || mode === 'walk';     // 새 모양: 연보라·진보라 건반, 음이름 + 숫자, 조작 최소
const walk = { by: 'scale', roots: KEYSIG_ORDER, gaps: false, circle: false, ...(config.walk ?? {}) };
walk.scales = scaleIds; walk.root = rootName;
walk.start ??= walk.by === 'root' ? Math.max(0, walk.roots.indexOf(rootName)) : 0;
walk.home ??= walk.start;
// 모드 창 5도권: 12칸(C 맨 위, 시계 방향 = 5도 위)
const NOTE_CIRCLE = ['C', 'G', 'D', 'A', 'E', 'B', 'F♯/G♭', 'D♭', 'A♭', 'E♭', 'B♭', 'F'];
---
<div class="piano-widget rounded-2xl border border-[var(--color-border)] bg-white overflow-hidden outline-none"
  tabindex="0" data-labels={labels} data-lo={lo} data-mode={mode} data-root={rootName} data-scale={scaleIds[0]} data-key={keyName} data-walk={mode === 'walk' ? JSON.stringify(walk) : undefined} aria-label="건반 위젯. 키보드 A부터 K까지로도 연주할 수 있어요">

  <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg flex items-center justify-center gradient-brand">
        <svg class="text-white" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 4v10M12 4v16M16 4v10"/></svg>
      </div>
      <div>
        <span class="font-bold text-base font-display">{title}</span>
        <span class="text-sm text-[var(--color-ink-300)] ml-2">Keyboard</span>
      </div>
    </div>
  </div>

  <div class="p-5 space-y-4">
    {mode === 'keysig' && (
      <div class="ks-head rounded-xl border border-[var(--color-border)] px-2 py-3 space-y-1">
        <div class="flex items-center justify-between gap-2">
          <button type="button" class="ks-arrow" data-d="-1" aria-label="♭ 쪽으로 한 칸 (5도 아래 조)">←</button>
          <svg class="ks-circle" viewBox="0 0 140 140" width="150" height="150" aria-hidden="true">
            <circle cx={CC} cy={CC} r={CR} fill="none" stroke="#e2e2f0" />
            <g class="ks-rot">
              {CIRCLE.map((_, i) => { const [x, y] = cpt(i); return <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="11" fill="white" />; })}
            </g>
            <circle cx={CC} cy={CC - CR} r="15" fill="#7c3aed" />
            <g class="ks-rot">
              {CIRCLE.map((k, i) => { const [x, y] = cpt(i); return (
                <g transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`}><text class="ks-cl" data-i={i} text-anchor="middle" dy="4" font-size={k.length > 2 ? 8.5 : 11.5}>{k}</text></g>
              ); })}
            </g>
          </svg>
          <button type="button" class="ks-arrow" data-d="1" aria-label="♯ 쪽으로 한 칸 (5도 위 조)">→</button>
        </div>
        <div class="flex items-center justify-center gap-3">
          <div class="ks-staff shrink-0"></div>
          <div class="min-w-0">
            <div class="ks-name text-lg font-bold text-[var(--color-ink-700)] font-display leading-tight" aria-live="polite"></div>
            <div class="ks-acc text-xs text-[var(--color-ink-500)] mt-0.5"></div>
          </div>
        </div>
      </div>
    )}
    {mode === 'walk' && (
      <div class="wk-head rounded-xl border border-[var(--color-border)] px-2 py-3 space-y-2">
        <div class="flex items-center justify-between gap-2">
          <button type="button" class="ks-arrow" data-d="-1" aria-label="이전">←</button>
          <div class="flex-1 min-w-0 flex flex-col items-center">
            {walk.circle && (
              <svg class="wk-circle" viewBox="0 0 140 140" width="150" height="150" aria-hidden="true">
                <circle cx={CC} cy={CC} r={CR} fill="none" stroke="#e2e2f0" />
                <path class="wk-band" d={(() => { const a0 = (-0.5 * 30 - 90) * Math.PI / 180, a1 = (6.5 * 30 - 90) * Math.PI / 180, R1 = CR + 13, R0 = CR - 13;
                  const P = (r: number, a: number) => `${(CC + r * Math.cos(a)).toFixed(1)} ${(CC + r * Math.sin(a)).toFixed(1)}`;
                  return `M ${P(R1, a0)} A ${R1} ${R1} 0 1 1 ${P(R1, a1)} L ${P(R0, a1)} A ${R0} ${R0} 0 1 0 ${P(R0, a0)} Z`; })()} fill="#ede6fd" />
                {NOTE_CIRCLE.map((k, i) => { const [x, y] = cpt(i); return (
                  <g transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`}>
                    <circle class="wk-dot" data-i={i} r="11" fill="white" />
                    <text class="wk-cl" data-i={i} text-anchor="middle" dy="4" font-size={k.length > 2 ? 8 : 11.5}>{k}</text>
                  </g>
                ); })}
              </svg>
            )}
            <div class="wk-name text-xl font-bold text-[var(--color-ink-700)] font-display leading-tight text-center" aria-live="polite"></div>
          </div>
          <button type="button" class="ks-arrow" data-d="1" aria-label="다음">→</button>
        </div>
        {walk.gaps && <div class="steps-row flex flex-wrap justify-center gap-1 text-[11px] font-mono"></div>}
      </div>
    )}
    <!-- 지금 누른 음 -->
    <div class:list={['rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-border)] px-4 py-3 text-center', clean && 'hidden']} aria-live="polite">
      <div class="now-kr text-3xl font-bold text-[var(--color-ink-700)] leading-tight font-display">건반을 눌러 보세요</div>
      <div class="now-en text-sm font-mono text-[var(--color-violet)] mt-1">&nbsp;</div>
    </div>

    <!-- 건반 -->
    <div class="kb relative select-none touch-none" style="height:150px">
      {whites.map((m, i) => (
        <button type="button" class:list={['key white', highlight.includes(m) && 'hl']} data-midi={m}
          style={`left:${i * W}%;width:${W}%`} aria-label={`${solfegeName(m)} ${midiName(m)}`}>
          {m === 60 && <span class="mid-c" title="가운데 도 (C4)"></span>}
          <span class="lab lab-kr">{solfegeName(m)}</span>
          <span class="lab lab-en">{midiName(m, 'sharp', m % 12 === 0)}</span>
          {clean && <span class="ks-lab"></span>}
        </button>
      ))}
      {keys.filter(isBlack).map(m => (
        <button type="button" class:list={['key black', highlight.includes(m) && 'hl']} data-midi={m}
          style={`left:${blackLeft(m)}%;width:${W * 0.6}%`} aria-label={`${solfegeName(m)} ${midiName(m)}`}>{clean && <span class="ks-lab"></span>}</button>
      ))}
    </div>
    <div class="flex items-center justify-between text-[10px] font-mono text-[var(--color-ink-300)]">
      <span><span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-violet)] align-middle mr-1"></span>가운데 도 (C4)</span>
      {!clean && <span class="hidden sm:inline">키보드 A W S E D F T G Y H U J K</span>}
    </div>

    {mode === 'scale' && <>
      <div class="steps-row flex flex-wrap justify-center gap-1 text-[11px] font-mono min-h-[1.5em]"></div>
      <div>
        <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink-300)] mb-1.5">으뜸음<span class="label-en">Root</span></div>
        <div class="grid grid-cols-6 gap-1 p-1 bg-[var(--color-surface-2)] rounded-xl" role="group">
          {ROOTS.map(r => <button type="button" class={`root-btn ${seg}`} style="padding-left:0;padding-right:0" data-v={r.name} aria-pressed={r.name === rootName ? 'true' : 'false'}>{r.name}</button>)}
        </div>
      </div>
      {scaleIds.length > 1 && (
        <div>
          <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink-300)] mb-1.5">음계<span class="label-en">Scale</span></div>
          <div class="grid gap-1 p-1 bg-[var(--color-surface-2)] rounded-xl" style={`grid-template-columns:repeat(${Math.min(scaleIds.length, 3)},1fr)`} role="group">
            {scaleIds.map((id, i) => <button type="button" class={`scale-btn ${seg}`} data-v={id} aria-pressed={i === 0 ? 'true' : 'false'}>{SCALES[id].kr}</button>)}
          </div>
        </div>
      )}
      <button type="button" class="scale-play w-full text-sm font-semibold py-2 rounded-xl gradient-brand text-white hover:opacity-90 transition">▶ 음계 들어보기</button>
    </>}

    {clean && <>
      <button type="button" class="scale-play w-full text-sm font-semibold py-2 rounded-xl gradient-brand text-white hover:opacity-90 transition">{mode === 'walk' ? '▶ 음계 들어보기' : '▶ 이 조의 음계 들어보기'}</button>
    </>}

    <!-- 표기 -->
    <div class:list={[clean && 'hidden']}>
      <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink-300)] mb-1.5">건반 위 이름<span class="label-en">Labels</span></div>
      <div class="flex gap-1 p-1 bg-[var(--color-surface-2)] rounded-xl" role="group">
        {labelOpts.map(([v, t]) => (
          <button type="button" class="lab-btn flex-1 px-2 py-1.5 rounded-lg text-xs font-semibold transition-all text-[var(--color-ink-500)] font-display"
            data-v={v} aria-pressed={v === labels ? 'true' : 'false'} >{t}</button>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .kb .key { position: absolute; top: 0; border: 0; padding: 0; cursor: pointer; transition: background .08s, transform .08s; }
  .kb .white { height: 100%; background: #fff; border: 1px solid var(--color-border); border-radius: 0 0 8px 8px; z-index: 1;
    display: flex; flex-direction: column; justify-content: flex-end; align-items: center; padding-bottom: 6px; gap: 1px; }
  .kb .black { height: 60%; background: #23232f; border-radius: 0 0 5px 5px; z-index: 2; box-shadow: 0 2px 3px rgba(0,0,0,.25); }
  .kb .white.hl { background: var(--color-violet-glow); }
  .kb .black.hl { background: #6d4fd8; }
  .kb .white.on { background: #ddd6fe; transform: translateY(1px); }
  .kb .black.on { background: #7c3aed; transform: translateY(1px); }
  .kb .lab { font-size: 10px; line-height: 1.1; color: var(--color-ink-500); pointer-events: none; font-family: 'Pretendard', sans-serif; }
  .kb .lab-en { font-family: 'JetBrains Mono', monospace; font-size: 9px; color: var(--color-ink-300); }
  .kb .mid-c { position: absolute; top: 42%; left: 50%; margin-left: -3px; width: 6px; height: 6px; border-radius: 50%; background: var(--color-violet); pointer-events: none; }
  .piano-widget[data-labels="kr"] .lab-en, .piano-widget[data-labels="en"] .lab-kr,
  .piano-widget[data-labels="none"] .lab { display: none; }
  .piano-widget:is([data-mode="keysig"], [data-mode="walk"]) .lab { display: none; }
  .piano-widget:is([data-mode="keysig"], [data-mode="walk"]) .kb .white.hl { background: #ede6fd; }
  .piano-widget:is([data-mode="keysig"], [data-mode="walk"]) .kb .black.hl { background: #7c3aed; }
  .kb .white .ks-lab.chg { color: var(--color-violet); }
  .kb .white .ks-lab.chg :global(small) { color: var(--color-violet); font-weight: 700; }
  .kb .black .ks-lab.chg { left: 1px; right: 1px; background: #fff; color: var(--color-violet); border-radius: 4px; padding: 1px 0; }
  .kb .black .ks-lab.chg :global(small) { color: var(--color-violet); font-weight: 700; }
  .wk-circle .wk-band { transform-origin: 70px 70px; transform: rotate(var(--rot, 0deg)); transition: transform .45s ease; }
  .wk-circle .wk-cl { fill: #a0a0c0; font-weight: 600; font-family: 'Space Grotesk', 'Pretendard', sans-serif; transition: fill .2s; }
  .wk-circle .wk-cl.in { fill: #2d2d4a; }
  .wk-circle .wk-cl.chg { fill: #fff; }
  .wk-circle .wk-dot { transition: fill .2s; }
  .wk-circle .wk-dot.in { fill: #ede6fd; }
  .wk-circle .wk-dot.chg { fill: #7c3aed; }
  .wk-circle .wk-dot.root { stroke: #2d2d4a; stroke-width: 1.5; }
  .kb .ks-lab { display: none; pointer-events: none; text-align: center; line-height: 1.15; }
  .kb .key.hl .ks-lab { display: block; }
  .kb .white .ks-lab { font-size: 11px; font-weight: 700; color: var(--color-ink-700); font-family: 'Space Grotesk', 'Pretendard', sans-serif; }
  .kb .black .ks-lab { position: absolute; left: -2px; right: -2px; bottom: 5px; white-space: nowrap; letter-spacing: -0.02em; font-size: 9px; font-weight: 700; color: #fff; font-family: 'Space Grotesk', 'Pretendard', sans-serif; }
  .kb .ks-lab :global(small) { display: block; font-size: 9.5px; font-weight: 500; color: var(--color-ink-500); font-family: 'Pretendard', sans-serif; }
  .kb .black .ks-lab :global(small) { color: #e9e3ff; }
  .ks-arrow { flex: none; width: 40px; height: 40px; border-radius: 999px; border: 1px solid var(--color-border); background: white; font-size: 18px; font-weight: 700; color: var(--color-violet); transition: all .1s; }
  .ks-arrow:hover:not(:disabled) { border-color: var(--color-violet); background: var(--color-violet-glow); }
  .ks-arrow:disabled { color: var(--color-ink-300); opacity: .5; cursor: default; }
  .ks-circle { --rot: 0deg; flex: none; }
  .ks-circle .ks-rot { transform-origin: 70px 70px; transform: rotate(var(--rot)); transition: transform .45s ease; }
  .ks-circle .ks-cl { transform-box: fill-box; transform-origin: center; transform: rotate(calc(-1 * var(--rot))); transition: transform .45s ease;
    fill: #6b6b8e; font-weight: 600; font-family: 'Space Grotesk', 'Pretendard', sans-serif; }
  .ks-circle .ks-cl.on { fill: #fff; font-weight: 700; }
  .ks-staff :global(.mus) { font-family: 'SL Music', 'Noto Music', serif; }
  .piano-widget:focus-visible { box-shadow: 0 0 0 2px var(--color-violet-light); }
</style>

<script>
import { AudioCore } from '../audio/core';
import { playKey } from '../audio/keys';
import { midiName, solfegeName, isBlack, intervalName, SCALES, ROOTS, spellScale, LETTER_PC, type Letter } from '../lib/music';

// ── keysig 모드 도우미 ──
const KR_LETTER: Record<string, string> = { C: '다', D: '라', E: '마', F: '바', G: '사', A: '가', B: '나' };
const KEYSIG_ORDER = ['G♭', 'D♭', 'A♭', 'E♭', 'B♭', 'F', 'C', 'G', 'D', 'A', 'E', 'B', 'F♯'];   // 조표 ♭6 → ♯6
const keyRootOf = (name: string) => ({ letter: name[0] as Letter, acc: name.includes('♯') ? 1 : name.includes('♭') ? -1 : 0 });
const keyKr = (name: string) => { const r = keyRootOf(name); return (r.acc > 0 ? '올림' : r.acc < 0 ? '내림' : '') + KR_LETTER[r.letter] + '장조'; };
// 높은음자리표 조표 위치(온음계 번호, E4 = 30) — Staff.astro와 같은 값
const SHARP_POS = [38, 35, 39, 36, 33, 37, 34], FLAT_POS = [34, 37, 33, 36, 32, 35, 31];
function keySigSvg(n: number) {
  const S = 8, TOP = 18, BOTTOM = TOP + 4 * S, yOf = (d: number) => BOTTOM - (d - 30) * S / 2;
  const pos = n > 0 ? SHARP_POS.slice(0, n) : FLAT_POS.slice(0, -n), w = Math.max(64, 40 + pos.length * 8 + 10), h = BOTTOM + 16;
  let out = `<svg viewBox="0 0 ${w} ${h}" width="${w * 1.15}" height="${h * 1.15}" role="img" aria-label="조표 ${n === 0 ? '없음' : `${n > 0 ? '샵' : '플랫'} ${Math.abs(n)}개`}">`;
  for (let i = 0; i < 5; i++) out += `<line x1="2" x2="${w - 2}" y1="${TOP + i * S}" y2="${TOP + i * S}" stroke="#3a3a48" stroke-width="0.9"/>`;
  out += `<text x="4" y="${TOP + 3 * S}" class="mus" font-size="${S * 4}" fill="#1d1d26">\u{1D11E}</text>`;
  pos.forEach((d, i) => { out += `<text x="${36 + i * 8}" y="${yOf(d) + (n > 0 ? 3 : 2)}" class="mus" font-size="${S * 1.7}" fill="${i === pos.length - 1 ? '#7c3aed' : '#1d1d26'}">${n > 0 ? '♯' : '♭'}</text>`; });
  return out + '</svg>';
}

// PC 키보드 → 반음 오프셋 (C부터 한 옥타브 + 도)
const KEYMAP: Record<string, number> = { a: 0, w: 1, s: 2, e: 3, d: 4, f: 5, t: 6, g: 7, y: 8, h: 9, u: 10, j: 11, k: 12 };

function initPiano(root: HTMLElement) {
  let core: AudioCore | null = null;
  const lo = Number(root.dataset.lo) || 60;
  const nowKr = root.querySelector('.now-kr') as HTMLElement;
  const nowEn = root.querySelector('.now-en') as HTMLElement;
  const keyEl = (m: number) => root.querySelector<HTMLElement>(`.key[data-midi="${m}"]`);

  const mode = root.dataset.mode || 'free';
  let first: number | null = null;          // interval 모드: 첫 음
  let spelled: Record<number, string> = {}; // scale 모드: pc → 음계 철자

  async function sound(m: number) {
    const el = keyEl(m); if (!el) return;
    core ??= new AudioCore();
    await core.resume();
    playKey(core, m);
    el.classList.add('on');
    setTimeout(() => el.classList.remove('on'), 180);
  }
  async function press(m: number) {
    await sound(m);
    if (mode === 'interval') {
      root.querySelectorAll('.key.hl').forEach(k => k.classList.remove('hl'));
      if (first == null) {
        first = m; keyEl(m)?.classList.add('hl');
        nowKr.textContent = solfegeName(m); nowEn.textContent = '두 번째 건반을 눌러 보세요';
      } else {
        const a = first, d = m - a; first = null;
        keyEl(a)?.classList.add('hl'); keyEl(m)?.classList.add('hl');
        nowKr.textContent = d === 0 ? '완전1도' : intervalName(d);
        nowEn.textContent = `${solfegeName(a)} → ${solfegeName(m)} · 반음 ${Math.abs(d)}개${d < 0 ? ' (아래로)' : ''}`;
        if (d !== 0 && core) playKey(core, a, core.ctx.currentTime + 0.45);
      }
      return;
    }
    const pc = ((m % 12) + 12) % 12;
    if (mode === 'keysig' || mode === 'walk') return;
    nowKr.textContent = spelled[pc] ? spelled[pc] : solfegeName(m);
    nowEn.textContent = isBlack(m) ? `${midiName(m, 'sharp')} = ${midiName(m, 'flat')}` : midiName(m);
  }

  // ── keysig 모드: 화살표로 5도권 순서를 따라 조를 넘긴다. 원은 지금 조가 맨 위로 오게 돌고, 조표의 마지막(새로 붙은) ♯·♭만 보라 ──
  if (mode === 'keysig') {
    let idx = Math.max(0, KEYSIG_ORDER.indexOf(root.dataset.key || 'G')), notes: number[] = [];
    const q = <T extends HTMLElement>(sel: string) => root.querySelector(sel) as T;
    const head = { staff: q('.ks-staff'), name: q('.ks-name'), acc: q('.ks-acc') };
    const circle = root.querySelector('.ks-circle') as SVGSVGElement;
    const MID = KEYSIG_ORDER.indexOf('C');
    const arrows = [...root.querySelectorAll<HTMLButtonElement>('.ks-arrow')];
    function apply() {
      const keyN = KEYSIG_ORDER[idx], n = idx - MID;
      const r = keyRootOf(keyN), sp = spellScale(r, SCALES.major);
      const deg: Record<number, number> = {};
      sp.forEach((x, i) => (deg[x.pc] = i));
      root.querySelectorAll<HTMLElement>('.key').forEach(k => {
        const pc = Number(k.dataset.midi) % 12, inKey = pc in deg;
        k.classList.toggle('hl', inKey);
        const lab = k.querySelector('.ks-lab');
        if (lab) lab.innerHTML = inKey ? `${sp[deg[pc]].name}<small>${deg[pc] + 1}</small>` : '';
      });
      const rootPc = (LETTER_PC[r.letter] + r.acc + 12) % 12, start = lo + ((rootPc - (lo % 12) + 12) % 12);
      notes = [...SCALES.major.steps.map(st => start + st), start + 12];
      const accs = sp.filter(x => x.acc !== 0);
      const list = (n > 0 ? 'FCGDAEB' : 'BEADGCF').slice(0, Math.abs(n)).split('').map(l => accs.find(x => x.letter === l)!.name).join(' ');
      head.staff.innerHTML = keySigSvg(n);
      head.name.innerHTML = `${keyKr(keyN)}<span class="label-en">${keyN} major</span>`;
      head.acc.textContent = n === 0 ? '조표 없음' : `${n > 0 ? '♯' : '♭'} ${Math.abs(n)}개 · ${list}`;
      // 원: n칸(♯ 쪽 = 시계 방향)에 있는 조가 맨 위로
      circle.style.setProperty('--rot', `${-n * 30}deg`);
      const cell = ((n % 12) + 12) % 12;
      circle.querySelectorAll('.ks-cl').forEach(t => t.classList.toggle('on', Number((t as SVGElement).dataset.i) === cell));
      arrows[0].disabled = idx === 0; arrows[1].disabled = idx === KEYSIG_ORDER.length - 1;
    }
    arrows.forEach(b => b.addEventListener('click', () => {
      const nx = idx + Number(b.dataset.d);
      if (nx < 0 || nx >= KEYSIG_ORDER.length) return;
      idx = nx; apply();
    }));
    root.querySelector('.scale-play')!.addEventListener('click', async () => {
      core ??= new AudioCore(); await core.resume();
      const t0 = core.ctx.currentTime + 0.05;
      notes.forEach((m, i) => { playKey(core!, m, t0 + i * 0.32, 0.5); setTimeout(() => { keyEl(m)?.classList.add('on'); setTimeout(() => keyEl(m)?.classList.remove('on'), 260); }, 50 + i * 320); });
    });
    apply();
  }

  // ── walk 모드: 화살표로 음계(또는 으뜸음)를 한 칸씩 넘긴다. 기준 상태에서 멀어지며 바뀐 음을 보라로 ──
  if (mode === 'walk') {
    const cfg = JSON.parse(root.dataset.walk!);
    type St = { root: string; sc: string };
    const states: St[] = cfg.by === 'root' ? cfg.roots.map((r: string) => ({ root: r, sc: cfg.scales[0] })) : cfg.scales.map((sc: string) => ({ root: cfg.root, sc }));
    let idx: number = cfg.start, notes: number[] = [];
    const nameEl = root.querySelector('.wk-name') as HTMLElement, stepsRow = root.querySelector<HTMLElement>('.steps-row'), circle = root.querySelector<SVGSVGElement>('.wk-circle');
    const arrows = [...root.querySelectorAll<HTMLButtonElement>('.ks-arrow')];
    const MAJ = SCALES.major.steps, STEP_TXT: Record<number, string> = { 1: '반', 2: '온', 3: '온반' };
    const spell = (st: St) => spellScale(keyRootOf(st.root), SCALES[st.sc]);
    const posOf = (pc: number) => (pc * 7) % 12;
    function apply() {
      const st = states[idx], sc = SCALES[st.sc], sp = spell(st);
      // 기준 쪽 이웃과 비교해 새로 들어온 음
      const nb = idx === cfg.home ? null : states[idx + (idx > cfg.home ? -1 : 1)];
      const before = nb ? new Set(spell(nb).map(x => x.pc)) : null;
      const info: Record<number, { name: string; num: string; chg: boolean }> = {};
      sp.forEach((x, i) => {
        const d = sc.deg[i], diff = sc.steps[i] - MAJ[d];
        info[x.pc] = { name: x.name, num: (diff < 0 ? '♭'.repeat(-diff) : '♯'.repeat(Math.max(0, diff))) + (d + 1), chg: !!before && !before.has(x.pc) };
      });
      root.querySelectorAll<HTMLElement>('.key').forEach(k => {
        const pc = Number(k.dataset.midi) % 12, it = info[pc];
        k.classList.toggle('hl', !!it);
        const lab = k.querySelector('.ks-lab');
        if (lab) { lab.innerHTML = it ? `${it.name}<small>${it.num}</small>` : ''; lab.classList.toggle('chg', !!it?.chg); }
      });
      const r = keyRootOf(st.root), rootPc = (LETTER_PC[r.letter] + r.acc + 12) % 12, start = lo + ((rootPc - (lo % 12) + 12) % 12);
      notes = [...sc.steps.map(x => start + x), start + 12];
      nameEl.innerHTML = `${st.root} ${sc.en}<span class="label-en">${sc.kr}</span>`;
      if (stepsRow) {
        const gaps = notes.slice(1).map((n, i) => n - notes[i]);
        const chip = (t: string) => `<span class="px-1.5 py-0.5 rounded bg-[var(--color-violet-glow)] text-[var(--color-violet)] font-bold">${t}</span>`;
        stepsRow.innerHTML = sp.map((x, i) => chip(x.name) + `<span class="text-[var(--color-ink-500)] self-center">${STEP_TXT[gaps[i]] ?? gaps[i]}</span>`).join('') + chip(sp[0].name);
      }
      if (circle) {
        // 7칸 창: 리디안이면 으뜸음에서 시계 방향 0~6칸, 한 단계 어두워질 때마다 반시계로 한 칸
        const rp = posOf(rootPc), ps = new Set(sp.map(x => posOf(x.pc)));
        let s0 = 0; for (let k = 0; k < 12; k++) if ([...Array(7).keys()].every(j => ps.has((k + j) % 12))) { s0 = k; break; }
        const off = ((s0 - rp + 18) % 12) - 6;          // 으뜸음 기준 창의 시작 칸(−6 ~ 5): 띠를 짧은 쪽으로 돌리기 위해
        circle.querySelector<SVGPathElement>('.wk-band')!.style.setProperty('--rot', `${(rp + off) * 30}deg`);
        circle.querySelectorAll<SVGElement>('.wk-dot, .wk-cl').forEach(el => {
          const p = Number(el.dataset.i), it = info[pcAt(p)];
          el.classList.toggle('in', ps.has(p)); el.classList.toggle('chg', ps.has(p) && !!it?.chg);
          if (el.classList.contains('wk-dot')) el.classList.toggle('root', p === rp);
        });
      }
      arrows[0].disabled = idx === 0; arrows[1].disabled = idx === states.length - 1;
    }
    const pcAt = (p: number) => (p * 7) % 12;
    arrows.forEach(b => b.addEventListener('click', () => {
      const nx = idx + Number(b.dataset.d);
      if (nx < 0 || nx >= states.length) return;
      idx = nx; apply();
    }));
    root.querySelector('.scale-play')!.addEventListener('click', async () => {
      core ??= new AudioCore(); await core.resume();
      const t0 = core.ctx.currentTime + 0.05;
      notes.forEach((m, i) => { playKey(core!, m, t0 + i * 0.32, 0.5); setTimeout(() => { keyEl(m)?.classList.add('on'); setTimeout(() => keyEl(m)?.classList.remove('on'), 260); }, 50 + i * 320); });
    });
    apply();
  }

  // ── scale 모드 ──
  if (mode === 'scale') {
    let rootN = root.dataset.root || 'C', scId = root.dataset.scale || 'major';
    const stepsRow = root.querySelector('.steps-row') as HTMLElement;
    let notes: number[] = [];
    const STEP_TXT: Record<number, string> = { 1: '반', 2: '온', 3: '온반', 4: '장3' };
    function apply() {
      const r = ROOTS.find(x => x.name === rootN)!, sc = SCALES[scId];
      const sp = spellScale(r, sc);
      spelled = {}; sp.forEach(x => (spelled[x.pc] = `${x.kr} (${x.name})`));
      const rootPc = (LETTER_PC[r.letter] + r.acc + 12) % 12;
      const start = lo + ((rootPc - (lo % 12) + 12) % 12);
      notes = [...sc.steps.map(st => start + st), start + 12];
      root.querySelectorAll('.key').forEach(k => k.classList.remove('hl'));
      notes.forEach(n => keyEl(n)?.classList.add('hl'));
      const gaps = notes.slice(1).map((n, i) => n - notes[i]);
      stepsRow.innerHTML = sp.map((x, i) => `<span class="px-1.5 py-0.5 rounded bg-[var(--color-violet-glow)] text-[var(--color-violet)] font-bold">${x.name}</span>` + (i < gaps.length ? `<span class="text-[var(--color-ink-300)] self-center">${STEP_TXT[gaps[i]] ?? gaps[i]}</span>` : '')).join('') + `<span class="px-1.5 py-0.5 rounded bg-[var(--color-violet-glow)] text-[var(--color-violet)] font-bold">${sp[0].name}</span>`;
      nowKr.textContent = `${r.name} ${sc.kr}`; nowEn.textContent = sc.desc;
    }
    const segSel = (cls: string, cb: (v: string) => void) => {
      const btns = root.querySelectorAll<HTMLButtonElement>(cls);
      const paint = (b: HTMLButtonElement) => { b.style.cssText = 'background:white;color:var(--color-violet);box-shadow:0 1px 4px rgba(0,0,0,0.08)'; };
      btns.forEach(b => { if (b.getAttribute('aria-pressed') === 'true') paint(b);
        b.addEventListener('click', () => { btns.forEach(x => { x.setAttribute('aria-pressed', 'false'); x.style.cssText = ''; }); b.setAttribute('aria-pressed', 'true'); paint(b); cb(b.dataset.v!); }); });
    };
    segSel('.root-btn', v => { rootN = v; apply(); });
    segSel('.scale-btn', v => { scId = v; apply(); });
    root.querySelector('.scale-play')!.addEventListener('click', async () => {
      core ??= new AudioCore(); await core.resume();
      const t0 = core.ctx.currentTime + 0.05;
      notes.forEach((n, i) => { playKey(core!, n, t0 + i * 0.32, 0.5); setTimeout(() => { keyEl(n)?.classList.add('on'); setTimeout(() => keyEl(n)?.classList.remove('on'), 260); }, 50 + i * 320); });
    });
    apply();
  }

  // 포인터: 누른 채로 미끄러지면 글리산도
  let down = false, last = -1;
  const kb = root.querySelector('.kb') as HTMLElement;
  const hit = (e: PointerEvent) => {
    const el = (document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null)?.closest<HTMLElement>('.key');
    return el && kb.contains(el) ? Number(el.dataset.midi) : -1;
  };
  kb.addEventListener('pointerdown', e => { down = true; last = hit(e); if (last >= 0) press(last); });
  kb.addEventListener('pointermove', e => { if (!down) return; const m = hit(e); if (m >= 0 && m !== last) { last = m; press(m); } });
  addEventListener('pointerup', () => { down = false; last = -1; });

  root.addEventListener('keydown', e => {
    if (mode === 'keysig' || mode === 'walk') return;
    if (e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
    const off = KEYMAP[e.key.toLowerCase()];
    if (off == null) return;
    e.preventDefault();
    const base = lo % 12 === 0 ? lo : lo + (12 - (lo % 12));
    press(base + off);
  });

  root.querySelectorAll<HTMLButtonElement>('.lab-btn').forEach(btn => {
    const sel = () => { btn.style.cssText = 'background:white;color:var(--color-violet);box-shadow:0 1px 4px rgba(0,0,0,0.08)'; };
    btn.addEventListener('click', () => {
      root.querySelectorAll<HTMLElement>('.lab-btn').forEach(b => { b.setAttribute('aria-pressed', 'false'); b.style.cssText = ''; });
      btn.setAttribute('aria-pressed', 'true'); sel();
      root.dataset.labels = btn.dataset.v!;
    });
    if (btn.getAttribute('aria-pressed') === 'true') sel();
  });
}

document.querySelectorAll<HTMLElement>('.piano-widget').forEach(initPiano);
</script>
