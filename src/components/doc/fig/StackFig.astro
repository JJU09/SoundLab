---
// 역할 쌓기 — 선 도면형. 위에서 아래로 층을 쌓은 그림 (주인공 → 바닥). 맨 위 층만 강조색
import Fig from './Fig.astro'; import { C } from './colors';
interface Layer { name: string; role: string; ex: string; color?: keyof typeof C; width?: number; }
interface Props { layers: Layer[]; caption?: string; }
const { layers, caption } = Astro.props as Props;
const W = 560, RH = 46, top = 2, H = top + layers.length * (RH + 6) - 4;
const rows = layers.map((l, i) => { const w = (l.width ?? 1) * (W - 4); return { ...l, w, x: (W - w) / 2, y: top + i * (RH + 6), hot: i === 0 }; });
---
<Fig caption={caption} minW={440} label={`파트의 역할: ${layers.map(l => `${l.name} — ${l.role}`).join(', ')}`}>
  <svg viewBox={`0 0 ${W} ${H}`}>
    {rows.map(r => <rect x={r.x} y={r.y} width={r.w} height={RH} rx="6" fill={r.hot ? C.violetG : 'white'} stroke={r.hot ? C.violet : C.ink3} stroke-width="1.5" />)}
    {rows.map(r => <text x={r.x + 16} y={r.y + 20} font-size="14" class="fd" fill={C.ink}>{r.name}</text>)}
    {rows.map(r => <text x={r.x + 16} y={r.y + 36} font-size="10.5" fill={C.ink5}>{r.ex}</text>)}
    {rows.map(r => <text x={r.x + r.w - 16} y={r.y + 28} text-anchor="end" font-size="12" font-weight="600" fill={r.hot ? C.violet : C.ink5}>{r.role}</text>)}
  </svg>
</Fig>
