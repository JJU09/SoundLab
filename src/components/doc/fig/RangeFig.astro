---
// 음역 지도 — 선 도면형. 파트별 음 범위를 옥타브 눈금 위 막대로, 범위는 막대 옆에 글자로
import Fig from './Fig.astro'; import { C } from './colors';
import { parseNote } from '../../../lib/music';
interface Part { name: string; from: string; to: string; color?: keyof typeof C; note?: string; warn?: boolean; }
interface Props { parts: Part[]; title?: string; caption?: string; low?: number; high?: number; }
const { parts, title, caption, low = 1, high = 7 } = Astro.props as Props;
const midi = (s: string) => parseNote(s)!.midi;
const lo = (low + 1) * 12, hi = (high + 1) * 12;
const L = 104, R = 548, W = 572, RH = 30, top = title ? 56 : 30, bottom = top + parts.length * RH, H = bottom + 26;
const x = (m: number) => L + (m - lo) / (hi - lo) * (R - L);
const octs = Array.from({ length: high - low + 1 }, (_, i) => ({ o: low + i, x: x((low + i + 1) * 12) }));
const bars = parts.map((p, i) => { const a = x(midi(p.from)), b = x(midi(p.to)); const txt = `${p.from}–${p.to}${p.note ? ` · ${p.note}` : ''}`; const left = b + 8 + txt.length * 6.4 > W;
  return { ...p, y: top + i * RH + RH / 2, a, b: Math.max(b, a + 8), txt, tx: left ? a - 8 : Math.max(b, a + 8) + 8, anchor: left ? 'end' : 'start', col: p.warn ? C.D : C.violet }; });
const showMid = lo <= 60 && hi >= 72;
const mid = { x: x(60), w: x(72) - x(60), cx: (x(60) + x(72)) / 2 };
---
<Fig caption={caption} minW={480} label={`${title ?? '음역 배치'}: ${parts.map(p => `${p.name} ${p.from}–${p.to}`).join(', ')}`}>
  <svg viewBox={`0 0 ${W} ${H}`}>
    {title && <text x="2" y="16" font-size="14" class="fd" fill={C.ink}>{title}</text>}
    {showMid && <rect x={mid.x} y={top - 6} width={mid.w} height={bottom - top + 6} fill={C.surf} />}
    {showMid && <text x={mid.cx} y={top - 12} text-anchor="middle" font-size="10" fill={C.ink5}>가운데 도 옥타브</text>}
    {octs.map(o => <line x1={o.x} x2={o.x} y1={top - 6} y2={bottom + 4} stroke={C.line} />)}
    <line x1={L} x2={R} y1={bottom} y2={bottom} stroke={C.ink3} />
    {octs.map(o => <text x={o.x} y={bottom + 18} text-anchor="middle" font-size="10" fill={C.ink5} class="mono">C{o.o}</text>)}
    {bars.map(b => <text x="2" y={b.y + 4} font-size="12" font-weight="600" fill={C.ink}>{b.name}</text>)}
    {bars.map(b => <line x1={b.a} x2={b.b} y1={b.y} y2={b.y} stroke={b.col} stroke-width="8" stroke-linecap="round" />)}
    {bars.map(b => <text x={b.tx} y={b.y + 3.5} text-anchor={b.anchor} font-size="10" class="mono" fill={b.warn ? C.D : C.ink5}>{b.txt}</text>)}
  </svg>
</Fig>
