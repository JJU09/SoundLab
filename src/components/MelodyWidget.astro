---
// 멜로디 스케치 위젯 — 음계 안의 음만 찍을 수 있는 피아노 롤(2마디, 8분음표 16칸). 코드 반주 위에서 들어 본다.
// config:
//   scale   : 'major' | 'majpent' (다장조 기준, 기본 majpent)
//   chords  : 반 마디마다 바뀌는 코드 (기본 C G Am F)
//   presets : 시작 예시 목록 — 'step'(차례가기) | 'leap'(뛰어가기) | 'motif'(모티브 반복) | 'empty'
interface Props { config?: Record<string, any>; }
const { config = {} } = Astro.props;
const scale = config.scale ?? 'majpent';
const chords: string[] = config.chords ?? ['C', 'G', 'Am', 'F'];
const presets: string[] = config.presets ?? ['motif', 'step', 'leap', 'empty'];
const PRESET_KR: Record<string, string> = { step: '차례가기', leap: '뛰어가기', motif: '모티브 반복', empty: '비우기' };
const ROWS: Record<string, [number, string][]> = {
  majpent: [[81, '라'], [79, '솔'], [76, '미'], [74, '레'], [72, '도'], [69, '라'], [67, '솔'], [64, '미'], [62, '레'], [60, '도']],
  major: [[72, '도'], [71, '시'], [69, '라'], [67, '솔'], [65, '파'], [64, '미'], [62, '레'], [60, '도']],
};
const rows = ROWS[scale] ?? ROWS.majpent;
const seg = 'px-2 py-1.5 rounded-lg text-xs font-semibold transition-all text-[var(--color-ink-500)]';
---
<div class="melody-widget rounded-2xl border border-[var(--color-border)] bg-white overflow-hidden"
  data-rows={JSON.stringify(rows.map(r => r[0]))} data-chords={JSON.stringify(chords)} data-scale={scale}>
  <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg flex items-center justify-center gradient-brand">
        <svg class="text-white" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><path d="M3 17l4-5 4 3 4-7 6 5"/></svg>
      </div>
      <div>
        <span class="font-bold text-base" style="font-family:'Space Grotesk','Pretendard',sans-serif">멜로디 스케치</span>
        <span class="text-sm text-[var(--color-ink-300)] ml-2">Melody</span>
      </div>
    </div>
    <button type="button" class="play-btn gradient-brand text-white text-sm font-semibold px-4 py-1.5 rounded-full transition hover:opacity-90" style="font-family:'Space Grotesk','Pretendard',sans-serif">▶ 재생</button>
  </div>
  <div class="p-5 space-y-3">
    <div class="grid gap-1 p-1 bg-[var(--color-surface-2)] rounded-xl" style={`grid-template-columns:repeat(${presets.length},1fr)`} role="group">
      {presets.map((p, i) => <button type="button" class={`pre-btn ${seg}`} data-v={p} aria-pressed={i === 0 ? 'true' : 'false'}>{PRESET_KR[p]}</button>)}
    </div>
    <div class="flex gap-1">
      <div class="flex flex-col gap-[2px] w-6 flex-none">
        {rows.map(r => <span class="h-[18px] text-[10px] leading-[18px] text-right text-[var(--color-ink-500)]">{r[1]}</span>)}
      </div>
      <div class="flex-1">
        <div class="roll grid gap-[2px]" style={`grid-template-columns:repeat(16,1fr);grid-template-rows:repeat(${rows.length},18px)`}>
          {rows.map((r, ri) => Array.from({ length: 16 }).map((_, c) => (
            <button type="button" class:list={['mc', c % 4 === 0 && 'bt', c === 8 && 'bar']} data-r={ri} data-c={c} aria-label={`${r[1]} ${c + 1}번째 칸`}></button>
          )))}
        </div>
        <div class="grid mt-1" style="grid-template-columns:repeat(4,1fr)">
          {chords.map(ch => <span class="text-center text-[11px] font-bold text-[var(--color-blue)]" style="font-family:'Space Grotesk','Pretendard',sans-serif">{ch}</span>)}
        </div>
      </div>
    </div>
    <p class="text-[11px] text-center text-[var(--color-ink-300)]">칸을 눌러 음을 찍어요 — 한 칸(세로줄)에 한 음. 아래는 반 마디마다 바뀌는 반주 코드</p>
  </div>
</div>

<style>
  .melody-widget .mc { border-radius: 3px; background: var(--color-surface-2); border: 1px solid var(--color-border); cursor: pointer; }
  .melody-widget .mc.bt { border-left-color: #c9c3ee; }
  .melody-widget .mc.bar { margin-left: 3px; }
  .melody-widget .mc.x { background: linear-gradient(135deg, #7c3aed, #2563eb); border-color: transparent; }
  .melody-widget .mc.now { outline: 2px solid #f59e0b; outline-offset: -1px; }
</style>

<script>
import { AudioCore } from '../audio/core';
import { playKey } from '../audio/keys';

const CHORD_PC: Record<string, number[]> = { C: [0, 4, 7], Dm: [2, 5, 9], Em: [4, 7, 11], F: [5, 9, 0], G: [7, 11, 2], Am: [9, 0, 4] };
// 프리셋: 칸마다 행 번호(-1 = 비움). 행 0이 가장 높음.
const PRE: Record<string, Record<string, number[]>> = {
  majpent: {
    motif: [6, 6, 5, -1, 4, -1, 5, -1, 6, 6, 5, -1, 4, 3, 4, -1],
    step:  [9, -1, 8, -1, 7, -1, 6, -1, 5, -1, 6, -1, 7, -1, 8, -1],
    leap:  [9, -1, 4, -1, 6, -1, 2, -1, 3, -1, 7, -1, 5, -1, 4, -1],
    empty: Array(16).fill(-1),
  },
  major: {
    motif: [7, 6, 5, -1, 3, -1, 5, -1, 7, 6, 5, -1, 4, -1, 5, -1],
    step:  [7, -1, 6, -1, 5, -1, 4, -1, 3, -1, 4, -1, 5, -1, 6, -1],
    leap:  [7, -1, 3, -1, 5, -1, 0, -1, 2, -1, 6, -1, 4, -1, 3, -1],
    empty: Array(16).fill(-1),
  },
};

function initMelody(root: HTMLElement) {
  const rows: number[] = JSON.parse(root.dataset.rows!), chords: string[] = JSON.parse(root.dataset.chords!);
  const lib = PRE[root.dataset.scale || 'majpent'] ?? PRE.majpent;
  let core: AudioCore | null = null;
  let col: number[] = [...lib.motif];
  const cell = (r: number, c: number) => root.querySelector<HTMLElement>(`.mc[data-r="${r}"][data-c="${c}"]`)!;
  const paint = () => { root.querySelectorAll('.mc').forEach(e => e.classList.remove('x')); col.forEach((r, c) => { if (r >= 0) cell(r, c).classList.add('x'); }); };
  paint();
  root.querySelectorAll<HTMLElement>('.mc').forEach(e => e.addEventListener('click', async () => {
    const r = Number(e.dataset.r), c = Number(e.dataset.c);
    col[c] = col[c] === r ? -1 : r; paint();
    if (col[c] >= 0) { core ??= new AudioCore(); await core.resume(); playKey(core, rows[r], core.ctx.currentTime, 0.4); }
  }));
  const btns = root.querySelectorAll<HTMLButtonElement>('.pre-btn');
  const sel = (b: HTMLButtonElement) => { b.style.cssText = 'background:white;color:var(--color-violet);box-shadow:0 1px 4px rgba(0,0,0,0.08)'; };
  btns.forEach(b => { if (b.getAttribute('aria-pressed') === 'true') sel(b);
    b.addEventListener('click', () => { btns.forEach(x => { x.setAttribute('aria-pressed', 'false'); x.style.cssText = ''; }); b.setAttribute('aria-pressed', 'true'); sel(b); col = [...(lib[b.dataset.v!] ?? lib.empty)]; paint(); }); });

  const playBtn = root.querySelector('.play-btn') as HTMLButtonElement;
  let playing = false, timer = 0, step = 0, next = 0;
  const bpm = 96, sp8 = 60 / bpm / 2;
  function tick() {
    const c = core!;
    while (next < c.ctx.currentTime + 0.12) {
      const i = step % 16, at = next;
      if (i % 4 === 0) { const ch = CHORD_PC[chords[i / 4]] ?? CHORD_PC.C; ch.forEach(pc => playKey(c, 48 + pc, at, sp8 * 4 * 0.95, 0.09)); }
      if (col[i] >= 0) {
        let len = 1; while (i + len < 16 && col[i + len] === -1 && len < 2) len++;
        playKey(c, rows[col[i]], at, Math.max(0.25, sp8 * len * 0.95), 0.28);
      }
      setTimeout(() => { root.querySelectorAll('.mc.now').forEach(e => e.classList.remove('now')); rows.forEach((_, r) => cell(r, i).classList.add('now')); }, Math.max(0, (at - c.ctx.currentTime) * 1000));
      next += sp8; step++;
    }
  }
  playBtn.addEventListener('click', async () => {
    if (playing) { playing = false; clearInterval(timer); playBtn.textContent = '▶ 재생'; root.querySelectorAll('.mc.now').forEach(e => e.classList.remove('now')); return; }
    core ??= new AudioCore(); await core.resume();
    playing = true; playBtn.textContent = '⏸ 정지'; step = 0; next = core.ctx.currentTime + 0.1;
    tick(); timer = window.setInterval(tick, 25);
  });
}
document.querySelectorAll<HTMLElement>('.melody-widget').forEach(initMelody);
</script>
