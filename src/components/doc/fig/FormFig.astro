---
// 곡 구조 타임라인 — 선 도면형. 단락 블록(폭 = 마디 수, 높이 = 에너지 1~5), 코러스만 강조색
import Fig from './Fig.astro'; import { C } from './colors';
type Kind = 'intro' | 'verse' | 'pre' | 'chorus' | 'bridge' | 'outro';
interface Sec { name: string; bars: number; energy: number; kind?: Kind; }
interface Props { sections: Sec[]; caption?: string; }
const { sections, caption } = Astro.props as Props;
const total = sections.reduce((n, s) => n + s.bars, 0);
const L = 34, W = 620, R = W - 4, top = 22, unit = 24, base = top + 5 * unit;
let acc = 0;
const blocks = sections.map(s => { const x = L + (acc / total) * (R - L); const w = (s.bars / total) * (R - L); acc += s.bars; const hot = s.kind === 'chorus';
  return { ...s, x: x + 2, w: w - 4, cx: x + w / 2, y: base - s.energy * unit, h: s.energy * unit, hot }; });
const grid = [1, 2, 3, 4, 5].map(e => ({ e, y: base - e * unit }));
---
<Fig caption={caption} minW={540} label={`곡 구조와 에너지: ${sections.map(s => `${s.name} ${s.energy}`).join(', ')}`}>
  <svg viewBox={`0 0 ${W} ${base + 40}`}>
    <text x="2" y="10" font-size="10" fill={C.ink5}>에너지</text>
    {grid.map(g => <line x1={L} x2={R} y1={g.y} y2={g.y} stroke={C.line} />)}
    {grid.map(g => <text x={L - 10} y={g.y + 3.5} font-size="10" fill={C.ink5} text-anchor="end" class="mono">{g.e}</text>)}
    {blocks.map(b => <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" fill={b.hot ? C.violetG : 'white'} stroke={b.hot ? C.violet : C.ink3} stroke-width="1.5" />)}
    <line x1={L} x2={R} y1={base} y2={base} stroke={C.ink} stroke-width="1.5" />
    {blocks.map(b => <text x={b.cx} y={base + 17} text-anchor="middle" font-size="11" font-weight="600" fill={b.hot ? C.violet : C.ink}>{b.name}</text>)}
    {blocks.map(b => <text x={b.cx} y={base + 31} text-anchor="middle" font-size="10" fill={C.ink5} class="mono">{b.bars}마디</text>)}
  </svg>
</Fig>
