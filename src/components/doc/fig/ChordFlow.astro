---
// 코드(또는 기능) 상자를 화살표로 잇는 흐름도 — 선 도면형. 테두리 색 = 화성 기능.
import Fig from './Fig.astro'; import { C, FN_TXT } from './colors';
type Fn = 'T' | 'S' | 'D' | 'B' | 'X';
interface Item { name: string; sub?: string; fn?: Fn; }
interface Props { items: Item[]; links?: string[]; loop?: string; legend?: boolean; caption?: string; label?: string; boxW?: number; }
const { items, links = [], loop, legend = false, caption, label, boxW = 84 } = Astro.props as Props;
const GAP = Math.max(46, ...links.map(l => (l ?? '').length * 9 + 16)), BH = 56, top = 14, n = items.length;
const W = n * boxW + (n - 1) * GAP + 16;
const H = top + BH + (loop ? 48 : 8) + (legend ? 26 : 0);
const xOf = (i: number) => 8 + i * (boxW + GAP);
const boxes = items.map((it, i) => ({ ...it, x: xOf(i), cx: xOf(i) + boxW / 2, col: it.fn ? C[it.fn] : C.ink3 }));
const arrows = boxes.slice(0, -1).map((b, i) => ({ x1: b.x + boxW + 6, x2: b.x + boxW + GAP - 8, mid: b.x + boxW + GAP / 2, label: links[i] ?? '' }));
const used = [...new Set(items.map(i => i.fn).filter(Boolean))] as Fn[];
const leg = used.map((f, i) => ({ x: 14 + i * 112, col: C[f], t: FN_TXT[f] }));
const ay = top + BH / 2;
const mid = 'sl-arrow-' + Math.random().toString(36).slice(2, 8); // 숨은 난이도 블록과 마커 id가 겹치지 않게
const loopPath = loop ? `M ${boxes[n - 1].cx} ${top + BH + 5} C ${boxes[n - 1].cx} ${top + BH + 36}, ${boxes[0].cx} ${top + BH + 36}, ${boxes[0].cx} ${top + BH + 9}` : '';
---
<Fig caption={caption} minW={Math.min(W, 640)} label={label ?? items.map(i => i.name).join(' → ')}>
  <svg viewBox={`0 0 ${W} ${H}`}>
    <defs><marker id={mid} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M1 1 L9 5 L1 9" fill="none" stroke={C.ink5} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></marker></defs>
    {boxes.map(b => <rect x={b.x} y={top} width={boxW} height={BH} rx="6" fill="white" stroke={b.col} stroke-width="1.5" />)}
    {boxes.map(b => <text x={b.cx} y={top + (b.sub ? 25 : 34)} text-anchor="middle" font-size="16" class="fd" fill={C.ink}>{b.name}</text>)}
    {boxes.filter(b => b.sub).map(b => <text x={b.cx} y={top + 43} text-anchor="middle" font-size="10.5" fill={C.ink5}>{b.sub}</text>)}
    {arrows.map(a => <line x1={a.x1} x2={a.x2} y1={ay} y2={ay} stroke={C.ink5} stroke-width="1.5" marker-end={`url(#${mid})`} />)}
    {arrows.filter(a => a.label).map(a => <text x={a.mid} y={ay - 8} text-anchor="middle" font-size="10" fill={C.ink5}>{a.label}</text>)}
    {loop && <path d={loopPath} fill="none" stroke={C.ink5} stroke-width="1.5" marker-end={`url(#${mid})`} />}
    {loop && <text x={W / 2} y={top + BH + 44} text-anchor="middle" font-size="10" fill={C.ink5}>{loop}</text>}
    {legend && leg.map(l => <rect x={l.x - 6} y={H - 15} width="12" height="9" rx="2" fill="white" stroke={l.col} stroke-width="1.5" />)}
    {legend && leg.map(l => <text x={l.x + 12} y={H - 7} font-size="10" fill={C.ink5}>{l.t}</text>)}
  </svg>
</Fig>
