---
// 파일럿 ① 비유형 — 화성 기능: 집 → 나들이 → 언덕 꼭대기 → 다시 집 / G7 → C의 반음 해결
// 언덕은 함수 h(x)로 정의하고, 공·발자국·화살표는 그 곡선에서 계산해 정확히 닿거나 일정 간격을 둔다.
import Explain from './Explain.astro';
import Label from './parts/Label.astro';
import Arrow from './parts/Arrow.astro';
import { INK, META, FN, FILL, STROKE, DASH } from './tokens';
import { fnPath, fnArea, restOn, sample, smooth, type Pt } from './parts/geo';
interface Props { simple?: boolean; }
const { simple = false } = Astro.props;
const uid = 'fn' + Math.random().toString(36).slice(2, 7);

// ── 비유: 언덕 = 작은 둔덕(나들이) + 큰 봉우리(도미넌트). 바깥은 평지라 집이 정확히 땅에 선다.
const GROUND = 246;
const rc = (x: number, c: number, w: number) => Math.abs(x - c) >= w ? 0 : (1 + Math.cos(Math.PI * (x - c) / w)) / 2;
const ss = (a: number, b: number, x: number) => { const t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); };
// 평지 → 완만한 언덕길(나들이) → 봉우리(도미넌트) → 집 쪽 평지. 골짜기 없이 한 번에 오르고 한 번에 내려온다.
const h = (x: number) => GROUND - 40 * ss(56, 116, x) * (1 - ss(226, 262, x)) - 140 * rc(x, 196, 58);
const PEAK = 196, BR = 14;
const ball = restOn(h, PEAK, BR);                                     // 공이 봉우리에 정확히 얹힘
const trail = sample(x => x, 64, 178, 30).map(([x]) => restOn(h, x, 9)); // 언덕 표면에서 9만큼 떠서 따라가는 발자국
const roll = sample(x => x, 214, 248, 14).map(([x]) => restOn(h, x, 12));
const hill = fnArea(h, 0, 320, 264, 80), hillLine = fnPath(h, 0, 320, 80);
const tension = [-150, -90, -30].map(a => { const r = (a * Math.PI) / 180;
  return { x1: ball[0] + Math.cos(r) * (BR + 5), y1: ball[1] + Math.sin(r) * (BR + 5), x2: ball[0] + Math.cos(r) * (BR + 11), y2: ball[1] + Math.sin(r) * (BR + 11) }; });
const house = (x: number, w: number) => ({
  wall: { x, y: GROUND - 30, w, h: 30 },
  roof: `M${x - 6},${GROUND - 28} L${x + w / 2},${GROUND - 52} L${x + w + 6},${GROUND - 28} Z`,
  door: { x: x + w / 2 - 6, y: GROUND - 18, w: 12, h: 18 },
  win: { x: x + w - 12, y: GROUND - 24, s: 8 },
});
const H1 = house(14, 38), H2 = house(276, 38);

// ── 원리: 성부 이동 표 + 건반(레 ~ 도)
const ROWS = [
  { a: '시 (B)', b: '도 (C)', t: '반음 위로 — 이끎음', y: 48, strong: true },
  { a: '솔 (G)', b: '솔 (G)', t: '그대로 — 공통음', y: 80, strong: false },
  { a: '파 (F)', b: '미 (E)', t: '반음 아래로 — 7음', y: 112, strong: true },
  { a: '레 (D)', b: '도 (C)', t: '흔히 온음 아래로', y: 144, strong: false },
];
const KW = 40, KX = 20, KY = 186, KH = 86;
const roles = ['D', 'T', 'D', 'DT', '', 'D', 'T'];
const names = ['레', '미', '파', '솔', '라', '시', '도'];
const whites = names.map((n, i) => ({ n, x: KX + i * KW, cx: KX + i * KW + KW / 2 - 1, role: roles[i],
  tc: roles[i] === 'T' ? FN.T : roles[i] ? FN.D : INK.sub }));
const blacks = [0, 2, 3, 4].map(i => KX + (i + 1) * KW - 12);          // 레♯ 파♯ 솔♯ 라♯ (미–파, 시–도 사이엔 없음 = 반음)
const kc = (i: number) => KX + i * KW + KW / 2 - 1;
const AY = KY + KH - 30;
const arcBC: [Pt, Pt] = [[kc(5) + 2, AY], [kc(6) - 2, AY]];
const arcFE: [Pt, Pt] = [[kc(2) - 2, AY], [kc(1) + 2, AY]];
---
<Explain simple={simple} title="화성 기능 — 긴장과 해결" question="왜 G7 다음에 C가 오면 '끝났다'고 느낄까?"
  label="화성 기능 설명 그림: 집을 나와 나들이를 하고 언덕 꼭대기에 오른 공이 집으로 굴러 내려오듯, 도미넌트 G7의 시와 파가 반음씩 움직여 토닉 C의 도와 미에 내려앉는다."
  map={[['집', '토닉 (I)'], ['나들이', '서브도미넌트 (IV)'], ['언덕 꼭대기', '도미넌트 (V7)'], ['굴러 내려옴', '해결 (V7 → I)']]}
  message="도미넌트의 시·파가 반음씩 움직여 토닉의 도·미에 내려앉는 것이 해결이다."
  caption="비유는 흐름의 느낌만 보여 줍니다. 긴장의 실제 원인은 시–파 트라이톤과 반음 이동이고, 곡의 문맥에 따라 다르게 풀리기도 합니다(거짓종지 등).">
  <svg slot="metaphor" viewBox="0 0 320 292" role="img" aria-label="집에서 나와 나들이를 하고 언덕 꼭대기에 오른 공이 다시 집으로 굴러 내려온다">
    <defs>
      <linearGradient id={`${uid}h`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c9ebd3" /><stop offset="1" stop-color="#a9dcb9" /></linearGradient>
      <radialGradient id={`${uid}b`} cx="0.38" cy="0.35" r="0.7"><stop offset="0" stop-color="#ffd98a" /><stop offset="1" stop-color={META.sun} /></radialGradient>
    </defs>
    <!-- 구름 -->
    <path d="M38 46 a10 10 0 0 1 14 -10 a13 13 0 0 1 24 4 a9 9 0 0 1 2 18 h-38 a8 8 0 0 1 -2 -12 Z" fill={META.cream} stroke={META.outline} stroke-width={STROKE.hair} />
    <path d="M262 40 a8 8 0 0 1 12 -7 a10 10 0 0 1 18 4 a7 7 0 0 1 0 14 h-28 a6 6 0 0 1 -2 -11 Z" fill={META.cream} stroke={META.outline} stroke-width={STROKE.hair} />
    <!-- 언덕 -->
    <path d={hill} fill={`url(#${uid}h)`} />
    <path d={hillLine} fill="none" stroke={META.outline} stroke-width={STROKE.base} stroke-linejoin="round" />
    <!-- 나들이 발자국: 언덕 표면을 일정 간격으로 따라감 -->
    <path d={smooth(trail)} fill="none" stroke={META.outline} stroke-width={STROKE.bold} stroke-dasharray={DASH.trail} stroke-linecap="round" />
    <!-- 집 두 채: 바닥이 땅선에 정확히 닿음 -->
    {[H1, H2].map(hs => <rect x={hs.wall.x} y={hs.wall.y} width={hs.wall.w} height={hs.wall.h} fill={META.sand} stroke={META.outline} stroke-width={STROKE.base} stroke-linejoin="round" />)}
    {[H1, H2].map(hs => <path d={hs.roof} fill={META.coral} stroke={META.outline} stroke-width={STROKE.base} stroke-linejoin="round" />)}
    {[H1, H2].map(hs => <rect x={hs.door.x} y={hs.door.y} width={hs.door.w} height={hs.door.h} rx="2" fill={META.cream} stroke={META.outline} stroke-width={STROKE.base} />)}
    {[H1, H2].map(hs => <rect x={hs.win.x} y={hs.win.y} width={hs.win.s} height={hs.win.s} rx="1" fill="#fff3c4" stroke={META.outline} stroke-width={STROKE.hair} />)}
    <!-- 꼭대기의 공 + 긴장 표시 -->
    {tension.map(t => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke={META.motion} stroke-width={STROKE.base} stroke-linecap="round" />)}
    <circle cx={ball[0]} cy={ball[1]} r={BR} fill={`url(#${uid}b)`} stroke={META.outline} stroke-width={STROKE.base} />
    <circle cx={ball[0] - 4.5} cy={ball[1] - 2} r="1.8" fill={META.outline} /><circle cx={ball[0] + 4.5} cy={ball[1] - 2} r="1.8" fill={META.outline} />
    <path d={`M${ball[0] - 4},${ball[1] + 5} h8`} fill="none" stroke={META.outline} stroke-width={STROKE.hair} stroke-linecap="round" />
    <!-- 굴러 내려옴: 비탈에서 일정 간격 떠서 따라가는 화살표 -->
    <Arrow pts={roll} color={META.motion} w="bold" />
    <!-- 이름표 -->
    <Label x={33} y={284} anchor="middle" color={META.outline} halo={false}>집</Label>
    <Label x={118} y={174} anchor="middle" color={META.outline} halo={META.bg}>나들이</Label>
    <Label x={ball[0]} y={14} anchor="middle" color={META.outline} halo={false}>언덕 꼭대기</Label>
    <Label x={250} y={136} color={META.motion} halo={META.bg}>굴러 내려옴</Label>
    <Label x={295} y={284} anchor="middle" color={META.outline} halo={false}>다시 집</Label>
  </svg>
  <svg slot="principle" viewBox="0 0 320 312" role="img" aria-label="G7에서 C로: 시는 도로 반음 올라가고, 파는 미로 반음 내려가고, 솔은 그대로 남는다. 시와 파는 트라이톤이다. 건반 위에서도 같은 이동을 보여 준다">
    <!-- ① 성부 이동 표 -->
    <Label x={74} y={20} size="title" anchor="middle" color={FN.D} weight={700}>G7 · 도미넌트</Label>
    <Label x={270} y={20} size="title" anchor="middle" color={FN.T} weight={700}>C · 토닉</Label>
    {ROWS.map(r => <rect x="46" y={r.y - 11} width="56" height="22" rx="11" fill={r.strong ? FILL.D : '#ffffff'} stroke={r.strong ? FN.D : INK.faint} stroke-width={r.strong ? STROKE.base : STROKE.hair} />)}
    {ROWS.map(r => <rect x="242" y={r.y - 11} width="56" height="22" rx="11" fill={r.strong ? FILL.T : '#ffffff'} stroke={r.strong ? FN.T : INK.faint} stroke-width={r.strong ? STROKE.base : STROKE.hair} />)}
    {ROWS.map(r => <text x="74" y={r.y + 4} text-anchor="middle" font-size="11" font-weight={r.strong ? 700 : 500} fill={r.strong ? INK.ink : INK.sub}>{r.a}</text>)}
    {ROWS.map(r => <text x="270" y={r.y + 4} text-anchor="middle" font-size="11" font-weight={r.strong ? 700 : 500} fill={r.strong ? INK.ink : INK.sub}>{r.b}</text>)}
    {ROWS.filter(r => r.strong).map(r => <Arrow from={[108, r.y]} to={[236, r.y]} color={INK.ink} w="base" />)}
    {ROWS.filter(r => !r.strong).map(r => <Arrow from={[108, r.y]} to={[236, r.y]} color={INK.faint} w="hair" dash={DASH.prev} />)}
    {ROWS.map(r => <text x="172" y={r.y - 7} text-anchor="middle" font-size={r.strong ? 11 : 10} font-weight={r.strong ? 700 : 400} fill={r.strong ? INK.ink : INK.sub}>{r.t}</text>)}
    <!-- 트라이톤 괄호 (시–파) -->
    <path d="M40 40 H33 V120 H40" fill="none" stroke={FN.D} stroke-width={STROKE.base} stroke-linejoin="round" />
    <Label x={22} y={80} anchor="middle" color={FN.D} weight={700} rotate={-90} halo={false}>트라이톤</Label>
    <!-- ② 건반에서 보면 -->
    <Label x={20} y={176} size="note" color={INK.sub} weight={500} halo={false}>건반에서 보면 — 검은 건반이 없는 두 곳이 반음</Label>
    {whites.map(k => <rect x={k.x} y={KY} width={KW - 2} height={KH} rx="4" fill={k.role === 'T' ? FILL.T : k.role === 'D' ? FILL.D : '#ffffff'} />)}
    <rect x={KX + 3 * KW} y={KY} width={(KW - 2) / 2} height={KH} fill={FILL.D} />
    <rect x={KX + 3 * KW + (KW - 2) / 2} y={KY} width={(KW - 2) / 2} height={KH} fill={FILL.T} />
    {whites.map(k => <rect x={k.x} y={KY} width={KW - 2} height={KH} rx="4" fill="none" stroke={INK.faint} stroke-width={STROKE.hair} />)}
    {blacks.map(x => <rect x={x} y={KY} width="22" height="50" rx="3" fill={INK.ink} />)}
    {whites.map(k => <text x={k.cx} y={KY + KH - 9} text-anchor="middle" font-size="11" font-weight="700" fill={k.tc}>{k.n}</text>)}
    <Arrow from={arcBC[0]} to={arcBC[1]} bend={16} color={INK.ink} w="base" size={7} />
    <Arrow from={arcFE[0]} to={arcFE[1]} bend={-16} color={INK.ink} w="base" size={7} />
    <Label x={(kc(5) + kc(6)) / 2} y={KY + KH + 16} anchor="middle" halo={false}>시 → 도 반음 ↑</Label>
    <Label x={(kc(1) + kc(2)) / 2} y={KY + KH + 16} anchor="middle" halo={false}>파 → 미 반음 ↓</Label>
    <Label x={160} y={306} size="note" anchor="middle" color={INK.sub} weight={400} halo={false}>빨강 = G7의 음 · 초록 = C의 음 · 솔은 둘 다</Label>
  </svg>
</Explain>
