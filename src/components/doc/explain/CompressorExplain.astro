---
// 파일럿 ② 작동 원리형 — 컴프레서: 문지기 비유 + 입력·출력 전달 곡선 (Threshold −20 dB, 4:1)
// 문 높이(인방 아래 끝) = 기준선 y 를 한 값(DOOR)으로 공유해 비유와 기준이 정확히 맞는다.
import Explain from './Explain.astro';
import Label from './parts/Label.astro';
import Arrow from './parts/Arrow.astro';
import { INK, META, TECH, FILL, STROKE, DASH } from './tokens';
import { capsule } from './parts/geo';
interface Props { simple?: boolean; }
const { simple = false } = Astro.props;

// ── 비유: 문 높이보다 큰 사람만 눌러서 통과. 넘은 키는 4분의 1만 남음(4:1)
const FLOOR = 192, DOOR = 92;
const squash = (top: number) => (top < DOOR ? DOOR - (DOOR - top) / 4 : top);
const P = (cx: number, w: number, top: number, c: string) => ({ cx, w, top, c, d: capsule(cx, FLOOR, w, FLOOR - top) });
const before = [P(22, 22, 142, META.sky), P(50, 24, 110, META.leaf), P(80, 26, 40, META.coral)];
const after = [P(222, 22, 142, META.sky), P(250, 24, 110, META.leaf), P(284, 26, squash(40), META.coral)];
const tallTop = squash(40), GR = 13;
const ghost = `M${284 - GR},${tallTop + GR} V${40 + GR} A${GR},${GR} 0 0 1 ${284 + GR},${40 + GR} V${tallTop + GR}`; // 깎인 부분만(바뀐 구간만 유령으로)
const keeper = P(148, 20, 130, META.sun);
const kc = keeper.cx, kt = keeper.top;
const cap = `M${kc - 13},${kt + 8} H${kc + 13} L${kc + 9},${kt + 2} Q${kc},${kt - 6} ${kc - 9},${kt + 2} Z`;
// 두 팔을 비스듬히 벌려 "잠깐!" — 손바닥(원)은 문기둥과 4 이상 떨어짐
const arms = [`M${kc - 9},${kt + 30} L${kc - 17},${kt + 16}`, `M${kc + 9},${kt + 30} L${kc + 17},${kt + 16}`];
const hands = [kc - 17, kc + 17];
const calm = [...before, ...after.slice(0, 2), keeper];
const tall = after[2];

// ── 원리: 전달 곡선 (−40 ~ 0 dB, 가로 5 · 세로 4 단위/dB)
const x0 = 46, x1 = 246, y0 = 40, y1 = 200, LO = -40;
const X = (d: number) => x0 + (d - LO) * 5;
const Y = (d: number) => y1 - (d - LO) * 4;
const TH = -20, R = 4;
const out = (d: number) => (d <= TH ? d : TH + (d - TH) / R);
const EX = -4;                                  // 입력 −4 dB → 출력 −16 dB, 게인 감소 12 dB
const xt = [-40, -30, -20, -10, 0], yt = [-30, -20, -10, 0];
const curve = `M${X(LO)},${Y(LO)} L${X(TH)},${Y(TH)} L${X(0)},${Y(out(0))}`;
// ③ 시간에 따른 막대: 입력(파랑) · 출력(보라) · 줄어든 양(주황)
const SB = 340, SS = 1.8;
const hOf = (d: number) => (d - LO) * SS;
const IN = [-30, -24, -6, -28, -12, -33];
const bars = IN.map((d, i) => { const o = out(d), gx = 56 + i * 42;
  return { gx, inY: SB - hOf(d), inH: hOf(d), outY: SB - hOf(o), outH: hOf(o), cut: d > TH }; });
const thY = SB - hOf(TH);
---
<Explain simple={simple} title="컴프레서" question="큰 소리만 골라서 어떻게 줄일까?"
  label="컴프레서 설명 그림: 문 높이보다 큰 사람만 문지기가 눌러 통과시키듯, 컴프레서는 Threshold를 넘은 소리만 Ratio만큼 줄인다. 4:1에서 입력 −4 dB는 출력 −16 dB가 된다."
  map={[['문지기', '컴프레서'], ['문 높이', 'Threshold'], ['넘은 키의 ¼만 남김', 'Ratio 4:1'], ['꾹 누른 만큼', '게인 감소 (Gain Reduction)']]}
  message="기준선을 넘은 만큼만 비율대로 줄여, 큰 소리와 작은 소리의 차이를 좁힌다."
  caption="예시는 Threshold −20 dB · Ratio 4:1. 실제 컴프레서는 어택·릴리즈 시간에 맞춰 서서히 반응하고, 줄어든 전체 음량은 메이크업 게인으로 되돌립니다.">
  <svg slot="metaphor" viewBox="0 0 320 222" role="img" aria-label="문 높이보다 큰 사람만 문지기가 눌러, 나간 뒤에는 문 높이를 넘은 키가 4분의 1만 남는다">
    <!-- 바닥 -->
    <rect x="0" y={FLOOR} width="320" height="8" fill={META.shade} />
    <line x1="0" x2="320" y1={FLOOR} y2={FLOOR} stroke={META.outline} stroke-width={STROKE.base} data-qa="ground" />
    <!-- 문 높이 = 기준선 (인방 아래 끝과 같은 y) -->
    <line x1="4" x2="316" y1={DOOR} y2={DOOR} stroke={META.chip} stroke-width={STROKE.base} stroke-dasharray={DASH.ref} />
    <Label x={4} y={DOOR - 7} color={META.chip} weight={700} halo={META.bg}>문 높이</Label>
    <!-- 문: 기둥 두 개 + 인방(아래 끝 = DOOR) -->
    <rect x="116" y={DOOR} width="8" height={FLOOR - DOOR} fill={META.sand} stroke={META.outline} stroke-width={STROKE.base} />
    <rect x="172" y={DOOR} width="8" height={FLOOR - DOOR} fill={META.sand} stroke={META.outline} stroke-width={STROKE.base} />
    <rect x="110" y={DOOR - 10} width="76" height="10" rx="2" fill={META.coral} stroke={META.outline} stroke-width={STROKE.base} />
    <!-- 줄어들기 전 키(유령) — 바탕색으로 칠해 기준선이 비치지 않게 -->
    <path d={ghost} fill={META.bg} stroke={META.coral} stroke-width={STROKE.base} stroke-dasharray={DASH.prev} />
    <!-- 사람들 -->
    {[...calm, tall].map(p => <path d={p.d} fill={p.c} stroke={META.outline} stroke-width={STROKE.base} />)}
    {calm.map(p => <circle cx={p.cx - 4} cy={p.top + 13} r="2" fill={META.outline} />)}
    {calm.map(p => <circle cx={p.cx + 4} cy={p.top + 13} r="2" fill={META.outline} />)}
    <!-- 눌린 사람: 질끈 감은 눈 -->
    <path d={`M${tall.cx - 7},${tall.top + 10} l3,2.5 l-3,2.5 M${tall.cx + 7},${tall.top + 10} l-3,2.5 l3,2.5`} fill="none" stroke={META.outline} stroke-width={STROKE.hair} stroke-linecap="round" stroke-linejoin="round" />
    <!-- 문지기: 모자는 머리에 얹혀 붙고, 두 팔은 문 안쪽에서 들어 올림 -->
    <path d={cap} data-qa="on" fill={META.outline} stroke={META.outline} stroke-width={STROKE.hair} stroke-linejoin="round" />
    {arms.map(a => <path d={a} fill="none" stroke={META.outline} stroke-width={STROKE.base} stroke-linecap="round" />)}
    {hands.map(x => <circle cx={x} cy={kt + 14} r="3.5" fill={META.sun} stroke={META.outline} stroke-width={STROKE.hair} />)}
    <!-- 흐름 -->
    <Arrow from={[96, 172]} to={[110, 172]} color={META.motion} w="bold" />
    <Arrow from={[186, 172]} to={[206, 172]} color={META.motion} w="bold" />
    <!-- 꾹: 유령 안에서 눌린 만큼 -->
    <Arrow from={[tall.cx, 46]} to={[tall.cx, tall.top - 5]} color={META.motion} w="base" size={7} />
    <Label x={266} y={66} size="title" anchor="end" color={META.motion} weight={700} halo={META.bg}>꾹</Label>
    <!-- 이름표 -->
    <Label x={52} y={216} anchor="middle" color={META.outline} halo={false}>들어오기 전</Label>
    <Label x={148} y={216} anchor="middle" color={META.outline} halo={false}>문지기</Label>
    <Label x={254} y={216} anchor="middle" color={META.outline} halo={false}>나간 뒤</Label>
  </svg>
  <svg slot="principle" viewBox="0 0 320 362" role="img" aria-label="전달 곡선: −20 dB까지는 1:1로 그대로 나가고, 넘은 뒤에는 4:1로 줄어 입력 −4 dB가 출력 −16 dB가 된다. 아래 막대는 시간에 따라 기준선을 넘은 소리만 줄어드는 모습">
    <!-- 구간 배경(불투명 연한 색, 겹치지 않음) -->
    <rect x={x0} y={y0} width={X(TH) - x0} height={y1 - y0} fill={FILL.input} />
    <rect x={X(TH)} y={y0} width={x1 - X(TH)} height={y1 - y0} fill={FILL.output} />
    <Label x={(x0 + X(TH)) / 2} y={30} anchor="middle" color={TECH.input} weight={700} halo={false}>① 1:1 · 그대로</Label>
    <Label x={(X(TH) + x1) / 2} y={30} anchor="middle" color={TECH.output} weight={700} halo={false}>② 4:1 · 줄임</Label>
    <!-- 축 -->
    <line x1={x0} x2={x1} y1={y1} y2={y1} stroke={TECH.axis} stroke-width={STROKE.hair} data-qa="axis" />
    <line x1={x0} x2={x0} y1={y0} y2={y1} stroke={TECH.axis} stroke-width={STROKE.hair} data-qa="axis" />
    {xt.map(d => <text x={X(d)} y={y1 + 14} text-anchor="middle" font-size="10" class="num" fill={INK.sub}>{d}</text>)}
    {yt.map(d => <text x={x0 - 6} y={Y(d) + 3.5} text-anchor="end" font-size="10" class="num" fill={INK.sub}>{d}</text>)}
    <Label x={x1} y={y1 + 30} size="note" anchor="end" color={INK.sub} weight={400} halo={false}>입력 크기 (dB) →</Label>
    <Label x={12} y={120} size="note" anchor="middle" color={INK.sub} weight={400} rotate={-90} halo={false}>출력 크기 (dB) →</Label>
    <!-- 기준선 -->
    <line x1={X(TH)} x2={X(TH)} y1={y0} y2={y1} stroke={TECH.limit} stroke-width={STROKE.base} stroke-dasharray={DASH.ref} />
    <Label x={X(TH) + 6} y={y1 - 8} size="note" color={TECH.limit} weight={700} halo={FILL.output}>Threshold −20</Label>
    <!-- 1:1이었다면(유령선) — 바뀌는 ② 구간에만 -->
    <line x1={X(TH)} y1={Y(TH)} x2={X(0)} y2={Y(0)} stroke={TECH.input} stroke-width={STROKE.hair} stroke-dasharray={DASH.prev} data-qa="ghost" />
    <!-- 실제 출력 -->
    <path d={curve} fill="none" stroke={TECH.output} stroke-width={STROKE.bold} stroke-linejoin="round" stroke-linecap="round" />
    <!-- 예시: −4 dB 입력 → 눌려서 −16 dB -->
    <Arrow from={[X(EX), Y(EX) + 6]} to={[X(EX), Y(out(EX)) - 6]} color={TECH.change} w="bold" />
    <circle cx={X(EX)} cy={Y(EX)} r="3.5" fill={TECH.input} />
    <circle cx={X(EX)} cy={Y(out(EX))} r="4" fill={TECH.output} stroke="#ffffff" stroke-width={STROKE.hair} />
    <Label x={252} y={60} color={TECH.input} halo={false}>입력 −4</Label>
    <Label x={252} y={82} color={TECH.change} weight={700} halo={false}>게인 감소</Label>
    <Label x={252} y={96} color={TECH.change} weight={700} halo={false}>12 dB</Label>
    <Label x={252} y={120} color={TECH.output} halo={false}>출력 −16</Label>
    <!-- ③ 시간에 따라 보면 -->
    <line x1="8" x2="312" y1="240" y2="240" stroke={INK.line} stroke-width={STROKE.hair} />
    <Label x={8} y={264} size="title" weight={700} halo={false}>③ 시간에 따라 보면</Label>
    <rect x="168" y="255" width="8" height="8" rx="1.5" fill={TECH.input} /><Label x={180} y={263} size="note" color={INK.sub} weight={500} halo={false}>입력</Label>
    <rect x="212" y="255" width="8" height="8" rx="1.5" fill={TECH.output} /><Label x={224} y={263} size="note" color={INK.sub} weight={500} halo={false}>출력</Label>
    <rect x="256" y="255" width="8" height="8" rx="1.5" fill={FILL.change} stroke={TECH.change} stroke-width={STROKE.hair} /><Label x={268} y={263} size="note" color={INK.sub} weight={500} halo={false}>줄어든 양</Label>
    {bars.map(b => <rect x={b.gx} y={b.inY} width="12" height={b.inH} rx="1.5" fill={TECH.input} />)}
    {bars.map(b => <rect x={b.gx + 14} y={b.outY} width="12" height={b.outH} rx="1.5" fill={TECH.output} />)}
    {bars.filter(b => b.cut).map(b => <rect x={b.gx + 14} y={b.inY} width="12" height={b.outY - b.inY - 1} rx="1.5" fill={FILL.change} stroke={TECH.change} stroke-width={STROKE.hair} />)}
    <line x1="50" x2="306" y1={thY} y2={thY} stroke={TECH.limit} stroke-width={STROKE.base} stroke-dasharray={DASH.ref} />
    <text x="46" y={thY + 3.5} text-anchor="end" font-size="10" class="num" fill={TECH.limit}>−20</text>
    <line x1="50" x2="306" y1={SB} y2={SB} stroke={TECH.axis} stroke-width={STROKE.hair} data-qa="axis" />
    <Label x={50} y={SB + 16} size="note" color={INK.sub} weight={400} halo={false}>기준선 아래 소리는 그대로</Label>
    <Label x={306} y={SB + 16} size="note" anchor="end" color={INK.sub} weight={400} halo={false}>시간 →</Label>
  </svg>
</Explain>
