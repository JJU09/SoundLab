---
// 도식 공통 틀 — 흰 카드 + 캡션. controls 슬롯 = 소리 나는 도식의 재생 버튼 줄. 좁은 화면에서는 minW 아래로 줄이지 않고 가로 스크롤.
interface Props { caption?: string; minW?: number; maxW?: number; label: string; }
const { caption, minW = 0, maxW = 0, label } = Astro.props;
---
<figure class="sl-fig not-prose my-4" role={Astro.slots.has('controls') ? 'group' : 'img'} aria-label={label}>
  <div class="rounded-xl border border-[var(--color-border)] bg-white p-4">
    <div class="overflow-x-auto"><div style={`${minW ? `min-width:${minW}px;` : ''}${maxW ? `max-width:${maxW}px;margin:0 auto;` : ''}`}><slot /></div></div>
    {Astro.slots.has('controls') && <div class="sl-fig-controls flex flex-wrap items-center gap-x-3 gap-y-1.5 mt-3 pt-3 border-t border-[var(--color-border)]"><slot name="controls" /></div>}
  </div>
  {caption && <figcaption class="text-[12.5px] leading-relaxed text-[var(--color-ink-500)] mt-2 text-center">{caption}</figcaption>}
</figure>
<style is:global>
  .sl-fig svg { display: block; width: 100%; height: auto; }
  .sl-fig svg text { font-family: 'Pretendard', sans-serif; }
  .sl-fig svg .fd { font-family: 'Space Grotesk', 'Pretendard', sans-serif; font-weight: 700; }
  .sl-fig svg .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
  .sl-fig-play { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; padding: 5px 12px 5px 10px; border-radius: 999px;
    border: 1px solid var(--color-border); color: var(--color-ink-700); background: white; cursor: pointer; transition: border-color .12s, color .12s; }
  .sl-fig-play:hover, .sl-fig-play[aria-pressed="true"] { border-color: var(--color-violet); color: var(--color-violet); }
  .sl-fig-play:focus-visible, .sl-fig [data-play]:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 2px; }
  .sl-fig-play svg { width: 12px; height: 12px; }
  .sl-fig-play .ic-stop, .sl-fig-play[aria-pressed="true"] .ic-play { display: none; }
  .sl-fig-play[aria-pressed="true"] .ic-stop { display: block; }
  .sl-fig-hint { font-size: 11.5px; color: var(--color-ink-500); }
</style>
