---
// 음역 지도 — 파트별 음 범위를 피아노 음역(C1~C7) 위 막대로
import Fig from './Fig.astro'; import { C } from './colors';
import { parseNote } from '../../../lib/music';
interface Part { name: string; from: string; to: string; color?: keyof typeof C; note?: string; }
interface Props { parts: Part[]; title?: string; caption?: string; low?: number; high?: number; }
const { parts, title, caption, low = 1, high = 7 } = Astro.props as Props;
const midi = (s: string) => parseNote(s)!.midi;
const lo = (low + 1) * 12, hi = (high + 1) * 12;
const L = 92, R = 560, W = 572, RH = 26, top = title ? 34 : 14, H = top + parts.length * RH + 30;
const x = (m: number) => L + (m - lo) / (hi - lo) * (R - L);
const octs = Array.from({ length: high - low + 1 }, (_, i) => ({ o: low + i, x: x((low + i + 1) * 12) }));
const bars = parts.map((p, i) => { const a = x(midi(p.from)), b = x(midi(p.to)); return { ...p, y: top + i * RH, a, w: Math.max(6, b - a), b, fill: C[p.color ?? 'violet'] }; });
const mid = { x: x(60), w: x(72) - x(60), cx: (x(60) + x(72)) / 2 };
---
<Fig caption={caption} minW={460} label={`${title ?? '음역 배치'}: ${parts.map(p => `${p.name} ${p.from}–${p.to}`).join(', ')}`}>
  <svg viewBox={`0 0 ${W} ${H}`}>
    {title && <text x="4" y="16" font-size="13" class="fd" fill={C.ink}>{title}</text>}
    <rect x={mid.x} y={top - 6} width={mid.w} height={H - top - 16} fill={C.violetG} opacity="0.5" />
    {octs.map(o => <line x1={o.x} x2={o.x} y1={top - 4} y2={H - 24} stroke={C.line} stroke-dasharray="3 3" />)}
    {octs.map(o => <text x={o.x} y={H - 10} text-anchor="middle" font-size="10" fill={C.ink3} class="mono">C{o.o}</text>)}
    <text x={mid.cx} y={H - 22} text-anchor="middle" font-size="9" fill={C.violet}>가운데 도 옥타브</text>
    {bars.map(b => <text x="4" y={b.y + 15} font-size="12" class="fd" fill={C.ink}>{b.name}</text>)}
    {bars.map(b => <rect x={b.a} y={b.y + 4} width={b.w} height="15" rx="7" fill={b.fill} opacity="0.85" />)}
    {bars.filter(b => b.note).map(b => <text x={b.b + 8} y={b.y + 15} font-size="10" fill={C.ink5}>{b.note}</text>)}
  </svg>
</Fig>
