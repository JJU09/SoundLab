---
// 코드(또는 기능) 상자를 화살표로 잇는 흐름도. fn 색 = 화성 기능.
import Fig from './Fig.astro'; import { C, FN_TXT } from './colors';
type Fn = 'T' | 'S' | 'D' | 'B' | 'X';
interface Item { name: string; sub?: string; fn?: Fn; }
interface Props { items: Item[]; links?: string[]; loop?: string; legend?: boolean; caption?: string; label?: string; boxW?: number; }
const { items, links = [], loop, legend = false, caption, label, boxW = 84 } = Astro.props as Props;
const GAP = Math.max(46, ...links.map(l => (l ?? '').length * 11 + 14)), BH = 58, top = 14, n = items.length;
const W = n * boxW + (n - 1) * GAP + 16;
const H = top + BH + (loop ? 46 : 18) + (legend ? 22 : 0);
const xOf = (i: number) => 8 + i * (boxW + GAP);
const boxes = items.map((it, i) => ({ ...it, x: xOf(i), cx: xOf(i) + boxW / 2, col: it.fn ? C[it.fn] : C.ink3 }));
const arrows = boxes.slice(0, -1).map((b, i) => ({ x1: b.x + boxW + 4, x2: b.x + boxW + GAP - 6, mid: b.x + boxW + GAP / 2, label: links[i] ?? '' }));
const used = [...new Set(items.map(i => i.fn).filter(Boolean))] as Fn[];
const leg = used.map((f, i) => ({ x: 8 + i * 112, fill: C[f], t: FN_TXT[f] }));
const ay = top + BH / 2;
const mid = 'sl-arrow-' + Math.random().toString(36).slice(2, 8); // 숨은 난이도 블록과 마커 id가 겹치지 않게
const loopPath = loop ? `M ${boxes[n - 1].cx} ${top + BH + 4} C ${boxes[n - 1].cx} ${top + BH + 36}, ${boxes[0].cx} ${top + BH + 36}, ${boxes[0].cx} ${top + BH + 8}` : '';
---
<Fig caption={caption} minW={Math.min(W, 520)} label={label ?? items.map(i => i.name).join(' → ')}>
  <svg viewBox={`0 0 ${W} ${H}`}>
    <defs><marker id={mid} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill={C.ink3} /></marker></defs>
    {boxes.map(b => <rect x={b.x} y={top} width={boxW} height={BH} rx="10" fill="white" stroke={b.col} stroke-width="1.6" />)}
    {boxes.map(b => <rect x={b.x + 1} y={top + BH - 6} width={boxW - 2} height="5" rx="2" fill={b.col} />)}
    {boxes.map(b => <text x={b.cx} y={top + (b.sub ? 26 : 35)} text-anchor="middle" font-size="17" class="fd" fill={C.ink}>{b.name}</text>)}
    {boxes.filter(b => b.sub).map(b => <text x={b.cx} y={top + 44} text-anchor="middle" font-size="11" fill={C.ink5}>{b.sub}</text>)}
    {arrows.map(a => <line x1={a.x1} x2={a.x2} y1={ay} y2={ay} stroke={C.ink3} stroke-width="1.6" marker-end={`url(#${mid})`} />)}
    {arrows.filter(a => a.label).map(a => <text x={a.mid} y={ay - 8} text-anchor="middle" font-size="10" fill={C.ink5}>{a.label}</text>)}
    {loop && <path d={loopPath} fill="none" stroke={C.ink3} stroke-width="1.4" stroke-dasharray="4 3" marker-end={`url(#${mid})`} />}
    {loop && <text x={W / 2} y={top + BH + 40} text-anchor="middle" font-size="10" fill={C.ink5}>{loop}</text>}
    {legend && leg.map(l => <rect x={l.x} y={H - 14} width="10" height="10" rx="2" fill={l.fill} />)}
    {legend && leg.map(l => <text x={l.x + 14} y={H - 5} font-size="10" fill={C.ink5}>{l.t}</text>)}
  </svg>
</Fig>
