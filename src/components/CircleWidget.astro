---
// 5도권 위젯 — 12개 조를 완전5도 간격으로 둘러놓은 원. 조를 누르면 조표·나란한조·이웃 조를 보여 주고 으뜸화음을 들려준다.
interface Props { config?: Record<string, any>; }
const { config = {} } = Astro.props;
// 시계 방향 = 5도 위. [장조, 나란한 단조, 조표(양수 ♯, 음수 ♭), 장조 으뜸음 pc]
const KEYS: [string, string, number, number][] = [
  ['C', 'Am', 0, 0], ['G', 'Em', 1, 7], ['D', 'Bm', 2, 2], ['A', 'F♯m', 3, 9], ['E', 'C♯m', 4, 4], ['B', 'G♯m', 5, 11],
  ['F♯/G♭', 'D♯m/E♭m', 6, 6], ['D♭', 'B♭m', -5, 1], ['A♭', 'Fm', -4, 8], ['E♭', 'Cm', -3, 3], ['B♭', 'Gm', -2, 10], ['F', 'Dm', -1, 5],
];
const cx = 150, cy = 150, R1 = 120, R2 = 80;
const pos = (i: number, r: number) => { const a = (i * 30 - 90) * Math.PI / 180; return [cx + r * Math.cos(a), cy + r * Math.sin(a)]; };
---
<div class="circle-widget rounded-2xl border border-[var(--color-border)] bg-white overflow-hidden" data-keys={JSON.stringify(KEYS)}>
  <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg flex items-center justify-center gradient-brand">
        <svg class="text-white" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>
      </div>
      <div>
        <span class="font-bold text-base" style="font-family:'Space Grotesk','Pretendard',sans-serif">5도권</span>
        <span class="text-sm text-[var(--color-ink-300)] ml-2">Circle of Fifths</span>
      </div>
    </div>
  </div>
  <div class="p-5 space-y-3">
    <svg viewBox="0 0 300 300" class="w-full max-w-[300px] mx-auto block select-none" role="group" aria-label="5도권">
      <circle cx={cx} cy={cy} r={R1 + 22} fill="#f6f5ff" />
      <circle cx={cx} cy={cy} r={R2 - 22} fill="white" />
      {KEYS.map(([maj, min], i) => {
        const [x1, y1] = pos(i, R1), [x2, y2] = pos(i, R2);
        return <g class="ck" data-i={i} style="cursor:pointer">
          <circle class="ck-maj" cx={x1} cy={y1} r="19" fill="white" stroke="#d6d1f5" />
          <text x={x1} y={y1 + 4} text-anchor="middle" font-size={maj.length > 2 ? 9 : 13} font-weight="800" fill="#2d2d4a" style="font-family:'Space Grotesk','Pretendard',sans-serif">{maj}</text>
          <circle class="ck-min" cx={x2} cy={y2} r="15" fill="white" stroke="#e5e2f7" />
          <text x={x2} y={y2 + 3.5} text-anchor="middle" font-size={min.length > 4 ? 7 : 10} font-weight="600" fill="#6b6b8e" style="font-family:'Space Grotesk','Pretendard',sans-serif">{min}</text>
        </g>;
      })}
      <text x={cx} y={cy - 4} text-anchor="middle" font-size="10" fill="#a0a0c0">시계 방향 = 5도 위</text>
      <text x={cx} y={cy + 10} text-anchor="middle" font-size="10" fill="#a0a0c0">안쪽 = 나란한 단조</text>
    </svg>
    <div class="info rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-border)] px-4 py-3 text-center" aria-live="polite">
      <div class="info-key text-2xl font-bold text-[var(--color-ink-700)]" style="font-family:'Space Grotesk','Pretendard',sans-serif">C 장조</div>
      <div class="info-sig text-sm text-[var(--color-violet)] font-semibold mt-0.5">조표 없음 · 나란한 단조 Am</div>
      <div class="info-nb text-xs text-[var(--color-ink-500)] mt-1">이웃 조(가장 가까운 조): F · G</div>
    </div>
    <p class="text-[11px] text-center text-[var(--color-ink-300)]">조를 누르면 으뜸화음이 울려요. 이웃한 조끼리는 음이 하나만 달라요.</p>
  </div>
</div>

<script>
import { AudioCore } from '../audio/core';
import { playKey } from '../audio/keys';

function initCircle(root: HTMLElement) {
  const KEYS: [string, string, number, number][] = JSON.parse(root.dataset.keys!);
  let core: AudioCore | null = null;
  const key = root.querySelector('.info-key') as HTMLElement, sig = root.querySelector('.info-sig') as HTMLElement, nb = root.querySelector('.info-nb') as HTMLElement;
  const sigTxt = (n: number) => n === 0 ? '조표 없음' : n > 0 ? `♯ ${n}개` : `♭ ${-n}개`;
  function select(i: number, play: boolean) {
    root.querySelectorAll<SVGElement>('.ck').forEach(g => {
      const j = Number(g.dataset.i), d = Math.min((j - i + 12) % 12, (i - j + 12) % 12);
      const maj = g.querySelector('.ck-maj') as SVGCircleElement, min = g.querySelector('.ck-min') as SVGCircleElement;
      maj.setAttribute('fill', j === i ? '#7c3aed' : d === 1 ? '#ddd6fe' : 'white');
      min.setAttribute('fill', j === i ? '#c4b5fd' : 'white');
      (g.querySelectorAll('text')[0] as SVGTextElement).setAttribute('fill', j === i ? 'white' : '#2d2d4a');
    });
    const [maj, min, s] = KEYS[i];
    key.textContent = `${maj} 장조`;
    sig.textContent = `${sigTxt(s)} · 나란한 단조 ${min}`;
    nb.textContent = `이웃 조(가장 가까운 조): ${KEYS[(i + 11) % 12][0]} · ${KEYS[(i + 1) % 12][0]}`;
    if (play) {
      const pc = KEYS[i][3], r = 60 + pc;
      const t = core!.ctx.currentTime + 0.03;
      [r, r + 4, r + 7].forEach(m => playKey(core!, m, t, 1.3, 0.22));
    }
  }
  root.querySelectorAll<SVGElement>('.ck').forEach(g => g.addEventListener('click', async () => {
    core ??= new AudioCore(); await core.resume();
    select(Number(g.dataset.i), true);
  }));
  select(0, false);
}
document.querySelectorAll<HTMLElement>('.circle-widget').forEach(initCircle);
</script>
